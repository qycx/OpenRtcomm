#endif

		  //  2014/06/19
		  if (pModule->common.bLoaded) {
			  continue;
		  }

		  if (pModule->common.path[0]) {
			  if (!(pModule->common.hModule = LoadLibrary(pModule->common.path))) {
				  _sntprintf(tBuf, mycountof(tBuf), _T("vvFailed to load (%s)"), pModule->common.path);
				  showInfo_open0(0, 0, tBuf);
#ifdef  __DEBUG__
				  traceLog((TCHAR*)_T("Failed to load the module %s ( %s )"), pModule->common.name, pModule->common.path);
#endif
				  continue;
			  }
		  }
		  pModule->common.bLoaded = TRUE;

		  switch (pModule->common.uiType) {
		  case  CONST_moduleType_vDev:
			  pModule->vDev.pf_qyVDev_getPtrProperty = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_getPtrProperty");
			  pModule->vDev.pf_qyVDev_getInfo = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_getInfo");
			  pModule->vDev.pf_qyVDev_getCfg = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_getCfg");
			  pModule->vDev.pf_qyVDev_chkBeforeInit = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_chkBeforeInit");
			  pModule->vDev.pf_qyVDev_chkAfterInit = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_chkAfterInit");
			  pModule->vDev.pf_qyVDev_op = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_op");
			  pModule->vDev.pf_qyVDev_postStr2Dev = (PF_qyVDev_postStr2Dev)myGetProcAddress(pModule->common.hModule, "qyVDev_postStr2Dev");
			  pModule->vDev.pf_qyVDev_postData2Dev = (PF_qyVDev_postData2Dev)myGetProcAddress(pModule->common.hModule, "qyVDev_postData2Dev");
			  pModule->vDev.pf_qyVDev_init = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_init");
			  pModule->vDev.pf_qyVDev_start = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_start");
			  pModule->vDev.pf_qyVDev_stop = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_stop");
			  pModule->vDev.pf_qyVDev_exit = (PF_commonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_exit");
			  pModule->vDev.pf_qyVDev_isSendable = (PF_bCommonHandler)myGetProcAddress(pModule->common.hModule, "qyVDev_isSendable");

			  if (!pModule->vDev.pf_qyVDev_getPtrProperty)  goto  errLabel;
			  QY_VDEV* pVDev;
			  if (!(pVDev = (QY_VDEV*)pModule->vDev.pf_qyVDev_getPtrProperty(0, (void*)CONST_qyPropertyId_vDev, 0)))  goto  errLabel;
			  //
			  pVDev->uiVDevId = uiVDevId;	uiVDevId++;	//  这是为了识别vDev的需要
			  //
			  pVDev->hModule = pModule->common.hModule;
			  pVDev->pGuiOpen = &pQyMc->guiOpen_vDev;
			  //
			  break;
		  case  CONST_moduleType_compress:
		  case  CONST_moduleType_ipp:
		  case  CONST_moduleType_mediaSdk_dec:
		  case  CONST_moduleType_mediaSdk_enc:
		  case  CONST_moduleType_mediaSdk_enc_conf:
			  //
		  case  CONST_moduleType_dec_vpl:
		  case  CONST_moduleType_enc_vpl:
			  //
		  case  CONST_moduleType_dec_amf:			//  2015/04/30
		  case  CONST_moduleType_enc_amf:
			  //
		  case  CONST_moduleType_dec_nv:				//  2017/01/07
		  case  CONST_moduleType_decD3d_nv:
		  case  CONST_moduleType_enc_nv:
		  case  CONST_moduleType_encD3d_nv:
			  //
		  //case  CONST_moduleType_cuda:
		  case  CONST_moduleType_qdc_vorbis_dec:		//  2015/02/13
		  case  CONST_moduleType_qdc_vorbis_enc:		//  2015/02/13
			  //
		  case  CONST_moduleType_dec_vp8:			//  2014/07/19
		  case  CONST_moduleType_enc_vp8:
			  //
			  pModule->compress.pf_qdcInit = (PF_qdcInit)myGetProcAddress(pModule->common.hModule, "qdcInit");
			  pModule->compress.pf_qdcExit = (PF_qdcExit)myGetProcAddress(pModule->common.hModule, "qdcExit");

			  //  2015/10/20
			  pModule->compress.pf_qdcGetProp = (PF_qdcGetProp)myGetProcAddress(pModule->common.hModule, "qdcGetProp");
			  //  2016/04/09
			  pModule->compress.pf_qdcSetProp = (PF_qdcSetProp)myGetProcAddress(pModule->common.hModule, "qdcSetProp");
			  if (pModule->compress.pf_qdcSetProp) {
				  int  ii = 0;
			  }

			  //
			  pModule->compress.pf_qdcGetCompressAudioCfg = (PF_qdcGetCompressAudioCfg)myGetProcAddress(pModule->common.hModule, "qdcGetCompressAudioCfg");
			  pModule->compress.pf_qdcGetCompressVideoCfg = (PF_qdcGetCompressVideoCfg)myGetProcAddress(pModule->common.hModule, "qdcGetCompressVideoCfg");

			  pModule->compress.pf_qdcInitCompressAudio = (PF_qdcInitCompressAudio)myGetProcAddress(pModule->common.hModule, "qdcInitCompressAudio");
			  pModule->compress.pf_qdcExitCompressAudio = (PF_qdcExitCompressAudio)myGetProcAddress(pModule->common.hModule, "qdcExitCompressAudio");
			  pModule->compress.pf_qdcCompressAudio = (PF_qdcCompressAudio)myGetProcAddress(pModule->common.hModule, "qdcCompressAudio");
			  //  2016/12/05
			  pModule->compress.pf_qdcCompressAudioRun = (PF_qdcCompressAudioRun)myGetProcAddress(pModule->common.hModule, "qdcCompressAudioRun");

			  //
			  pModule->compress.pf_qdcInitDecompressAudio = (PF_qdcInitDecompressAudio)myGetProcAddress(pModule->common.hModule, "qdcInitDecompressAudio");
			  pModule->compress.pf_qdcExitDecompressAudio = (PF_qdcExitDecompressAudio)myGetProcAddress(pModule->common.hModule, "qdcExitDecompressAudio");
			  pModule->compress.pf_qdcDecompressAudio = (PF_qdcDecompressAudio)myGetProcAddress(pModule->common.hModule, "qdcDecompressAudio");
			  //  2016/12/05
			  pModule->compress.pf_qdcDecompressAudioRun = (PF_qdcDecompressAudioRun)myGetProcAddress(pModule->common.hModule, "qdcDecompressAudioRun");


			  //
			  pModule->compress.pf_qdcInitCompressVideo = (PF_qdcInitCompressVideo)myGetProcAddress(pModule->common.hModule, "qdcInitCompressVideo");
			  pModule->compress.pf_qdcExitCompressVideo = (PF_qdcExitCompressVideo)myGetProcAddress(pModule->common.hModule, "qdcExitCompressVideo");
			  pModule->compress.pf_qdcCompressVideo = (PF_qdcCompressVideo)myGetProcAddress(pModule->common.hModule, "qdcCompressVideo");
			  pModule->compress.pf_qdcCompressVideoRun = (PF_qdcCompressVideoRun)myGetProcAddress(pModule->common.hModule, "qdcCompressVideoRun");	//  2014/04/02
			  pModule->compress.pf_qdcGetSpsPps = (PF_qdcGetSpsPps)myGetProcAddress(pModule->common.hModule, "qdcGetSpsPps");	//  2014/03/30
			  //
			  pModule->compress.pf_qdcInitDecompressVideo = (PF_qdcInitDecompressVideo)myGetProcAddress(pModule->common.hModule, "qdcInitDecompressVideo");
			  pModule->compress.pf_qdcExitDecompressVideo = (PF_qdcExitDecompressVideo)myGetProcAddress(pModule->common.hModule, "qdcExitDecompressVideo");
			  pModule->compress.pf_qdcDecompressVideo = (PF_qdcDecompressVideo)myGetProcAddress(pModule->common.hModule, "qdcDecompressVideo");

			  //  2011/12/10
			  pModule->compress.pf_qdcDecompressVideoAndOutput = (PF_qdcDecompressVideoAndOutput)myGetProcAddress(pModule->common.hModule, "qdcDecompressVideoAndOutput");

			  //  2014/03/28
			  pModule->compress.pf_qdcDecompressVideoRun = (PF_qdcDecompressVideoRun)myGetProcAddress(pModule->common.hModule, "qdcDecompressVideoRun");

			  //
			  pModule->compress.pf_qdcGetOutputByIndex = (PF_qdcGetOutputByIndex)myGetProcAddress(pModule->common.hModule, "qdcGetOutputByIndex");
			  pModule->compress.pf_qdcClearOutputs = (PF_qdcClearOutputs)myGetProcAddress(pModule->common.hModule, "qdcClearOutputs");

			  break;
		  case  CONST_moduleType_ffmpeg: {
			  //
			  pModule->compress.pf_qdcInit = qdcInit_ffmpeg;
			  pModule->compress.pf_qdcExit = qdcExit_ffmpeg;

			  //				   
			  pModule->compress.pf_qdcInitCompressVideo = qdcInitCompressVideo_ffmpeg;
			  pModule->compress.pf_qdcExitCompressVideo = qdcExitCompressVideo_ffmpeg;
			  pModule->compress.pf_qdcGetSpsPps = qdcGetSpsPps_ffmpeg;
			  pModule->compress.pf_qdcCompressVideo = qdcCompressVideo_ffmpeg;

			  //
			  pModule->compress.pf_qdcInitDecompressVideo = qdcInitDecompressVideo_ffmpeg;
			  pModule->compress.pf_qdcExitDecompressVideo = qdcExitDecompressVideo_ffmpeg;
			  pModule->compress.pf_qdcDecompressVideo = qdcDecompressVideo_ffmpeg;

			  //
			  pModule->compress.pf_qdcInitCompressAudio = qdcInitCompressAudio_ffmpeg;
			  pModule->compress.pf_qdcExitCompressAudio = qdcExitCompressAudio_ffmpeg;
			  pModule->compress.pf_qdcCompressAudio = qdcCompressAudio_ffmpeg;
			  pModule->compress.pf_qdcCompressAudioRun = qdcCompressAudioRun_ffmpeg;
			  pModule->compress.pf_qdcGetOutputByIndex = qdcGetOutputByIndex_ffmpeg;
			  pModule->compress.pf_qdcClearOutputs = qdcClearOutputs_ffmpeg;
			  //
			  pModule->compress.pf_qdcInitDecompressAudio = qdcInitDecompressAudio_ffmpeg;
			  pModule->compress.pf_qdcExitDecompressAudio = qdcExitDecompressAudio_ffmpeg;
			  pModule->compress.pf_qdcDecompressAudio = qdcDecompressAudio_ffmpeg;
			  pModule->compress.pf_qdcCompressAudioRun = qdcDecompressAudioRun_ffmpeg;

		  }
									   break;
		  case  CONST_moduleType_lyra: {
			  //
			  pModule->compress.pf_qdcInit = qdcInit_lyra;
			  pModule->compress.pf_qdcExit = qdcExit_lyra;

			  //
			  pModule->compress.pf_qdcInitCompressAudio = qdcInitCompressAudio_lyra;
			  pModule->compress.pf_qdcExitCompressAudio = qdcExitCompressAudio_lyra;
			  pModule->compress.pf_qdcCompressAudio = qdcCompressAudio_lyra;
			  pModule->compress.pf_qdcCompressAudioRun = qdcCompressAudioRun_lyra;
			  pModule->compress.pf_qdcGetOutputByIndex = qdcGetOutputByIndex_lyra;
			  pModule->compress.pf_qdcClearOutputs = qdcClearOutputs_lyra;
			  //
			  pModule->compress.pf_qdcInitDecompressAudio = qdcInitDecompressAudio_lyra;
			  pModule->compress.pf_qdcExitDecompressAudio = qdcExitDecompressAudio_lyra;
			  pModule->compress.pf_qdcDecompressAudio = qdcDecompressAudio_lyra;
			  pModule->compress.pf_qdcCompressAudioRun = qdcDecompressAudioRun_lyra;

		  }
									 //
									 break;

		  case CONST_moduleType_aac: {
			  pModule->compress.pf_qdcInit = qdcInit_aac;
			  pModule->compress.pf_qdcExit = qdcExit_aac;

			  pModule->compress.pf_qdcGetOutputByIndex = qdcGetOutputByIndex_aac;
			  pModule->compress.pf_qdcClearOutputs = qdcClearOutputs_aac;

			  pModule->compress.pf_qdcInitDecompressAudio = qdcInitDecompressAudio_aac;
			  pModule->compress.pf_qdcExitDecompressAudio = qdcExitDecompressAudio_aac;
			  pModule->compress.pf_qdcDecompressAudio = qdcDecompressAudio_aac;
			  pModule->compress.pf_qdcCompressAudioRun = qdcDecompressAudioRun_aac;
		  }
								   break;
		  case  CONST_moduleType_camCap:
			  if (sizeof(MODULE_camCap) > sizeof(pModule[0]))  goto  errLabel;
			  MODULE_camCap* pCamCap;	pCamCap = (MODULE_camCap*)pModule;

			  pCamCap->pf_setGuiOpen = (PF_setGuiOpen)myGetProcAddress(pModule->common.hModule, "setGuiOpen");

			  //
			  pCamCap->pf_doInitRecordSound = (PF_doInitRecordSound)myGetProcAddress(pModule->common.hModule, "doInitRecordSound");
			  pCamCap->pf_doExitRecordSound = (PF_doExitRecordSound)myGetProcAddress(pModule->common.hModule, "doExitRecordSound");

			  //
			  pCamCap->pf_initVideoCapDev = (PF_initVideoCapDev)myGetProcAddress(pModule->common.hModule, "initVideoCapDev");
			  pCamCap->pf_exitVideoCapDev = (PF_exitVideoCapDev)myGetProcAddress(pModule->common.hModule, "exitVideoCapDev");
			  pCamCap->pf_bGetCapturePara = (PF_bGetCapturePara)myGetProcAddress(pModule->common.hModule, "bGetCapturePara");
			  pCamCap->pf_startCapture = (PF_startCapture)myGetProcAddress(pModule->common.hModule, "startCapture");
			  pCamCap->pf_stopCapture = (PF_stopCapture)myGetProcAddress(pModule->common.hModule, "stopCapture");

#ifdef  __DEBUG__
#if  0
			  //  for test
			  pCamCap->pf_initVideoCapDev = initVideoCapDev_dx;
			  pCamCap->pf_exitVideoCapDev = exitVideoCapDev_dx;
			  pCamCap->pf_bGetCapturePara = bGetCapturePara_dx;
			  pCamCap->pf_startCapture = startCapture_dx;
			  pCamCap->pf_stopCapture = stopCapture_dx;
#endif
#endif

			  traceLog((TCHAR*)_T("module camCap loaded"));
			  //
			  break;
		  default:
			  break;
		  }

		  //
		  continue;
	  }

	  //
#if  0
	  pQyMc->cusModules.pIpp = getCusModule(&pQyMc->cusModules, CONST_moduleType_ipp);
#endif 

	  //
	  pQyMc->cusModules.pMediaSdk_dec = getCusModule(&pQyMc->cusModules, CONST_moduleType_mediaSdk_dec);
	  pQyMc->cusModules.pMediaSdk_enc = getCusModule(&pQyMc->cusModules, CONST_moduleType_mediaSdk_enc);
	  //pQyMc->cusModules.pMediaSdk_enc_conf = getCusModule(&pQyMc->cusModules, CONST_moduleType_mediaSdk_enc_conf);
	  //
	  pQyMc->cusModules.pDec_vpl = getCusModule(&pQyMc->cusModules, CONST_moduleType_dec_vpl);
	  pQyMc->cusModules.pEnc_vpl = getCusModule(&pQyMc->cusModules, CONST_moduleType_enc_vpl);


	  //  
	  pQyMc->cusModules.pDec_nv = getCusModule(&pQyMc->cusModules, CONST_moduleType_dec_nv);
	  pQyMc->cusModules.pDecD3d_nv = getCusModule(&pQyMc->cusModules, CONST_moduleType_decD3d_nv);
	  pQyMc->cusModules.pEnc_nv = getCusModule(&pQyMc->cusModules, CONST_moduleType_enc_nv);
	  pQyMc->cusModules.pEncD3d_nv = getCusModule(&pQyMc->cusModules, CONST_moduleType_encD3d_nv);

	  //  2015/04/30
	  pQyMc->cusModules.pDec_amf = getCusModule(&pQyMc->cusModules, CONST_moduleType_dec_amf);
	  pQyMc->cusModules.pEnc_amf = getCusModule(&pQyMc->cusModules, CONST_moduleType_enc_amf);


	  //  2015/02/13
	  pQyMc->cusModules.pQdc_vorbis_dec = getCusModule(&pQyMc->cusModules, CONST_moduleType_qdc_vorbis_dec);
	  pQyMc->cusModules.pQdc_vorbis_enc = getCusModule(&pQyMc->cusModules, CONST_moduleType_qdc_vorbis_enc);


	  //  2014/07/18 
	  pQyMc->cusModules.pDec_vp8 = getCusModule(&pQyMc->cusModules, CONST_moduleType_dec_vp8);
	  pQyMc->cusModules.pEnc_vp8 = getCusModule(&pQyMc->cusModules, CONST_moduleType_enc_vp8);

	  //
	  pQyMc->cusModules.pFfmpeg = getCusModule(&pQyMc->cusModules, CONST_moduleType_ffmpeg);

	  pQyMc->cusModules.pAAC = getCusModule(&pQyMc->cusModules, CONST_moduleType_aac);

	  //
	  pQyMc->cusModules.pLyra = getCusModule(&pQyMc->cusModules, CONST_moduleType_lyra);


	  //
	  PARAM_getModuleInfo param_getModuleInfo;
	  memset(&param_getModuleInfo, 0, sizeof(param_getModuleInfo));
	  if (pQyMc->cusModules.pEnc_vpl) {
		  CUS_MODULE_U* pModule = pQyMc->cusModules.pEnc_vpl;
		  if (pModule && pModule->common.bLoaded) {
			  if (pModule->compress.pf_qdcGetSpsPps) {
				  //
				  pModule->compress.pf_qdcGetProp(CONST_adcPropId_getModuleInfo, mynull, &param_getModuleInfo);
				  //
				  _sntprintf(tBuf, mycountof(tBuf), _T("vpl apiVer: %d.%d"), (int)param_getModuleInfo.usMajor, (int)param_getModuleInfo.usMinor);
				  showInfo_open(0, 0, 0, tBuf);
				  //
				  int  ii = 0;
			  }
		  }
	  }
	  //
	  bool bUse_msdk;  bUse_msdk = true;
	  //
	  bool bIntelGpu;
	  UINT deviceId;
	  deviceId = 0;
	  bIntelGpu = bDetectIntelGPU(deviceId);
	  if (bIntelGpu) {
		  int gen;
		  gen = getIntelGPUGen(deviceId);
		  //
		  _sntprintf(tBuf, mycountof(tBuf), _T("intelGrp gen: %d."), gen);
		  showInfo_open(0, 0, 0, tBuf);

		  //  为判断是否使用vpl, 还需要检查api版本号。只有>=2.2才能用vpl. 否则，用msdk
		  //
		  if (gen >= 9
			  &&  param_getModuleInfo.usMajor  >=2
			  //&&  param_getModuleInfo.usMinor >=2  
			  )
		  {
			  bUse_msdk = false;
		  }
	  }
	  //
#ifdef  __DEBUG__
	  //
	  if (0) {
		  //showInfo_open(0, 0, 0, _T("test: bUse_msdk set to true"));
		  //bUse_msdk = true;
	  }
	  //
#endif 

	  //
	  pQyMc->bUse_msdk = bUse_msdk;
	  //
	  //
	  if (  bUse_msdk  ) {
		  showInfo_open(0, 0, 0, _T("use msdk"));
	  }
	  else {
		  showInfo_open(0, 0, 0, _T("use vpl"));

	  }

	  


	  //  2014/06/19
#if  0
	  myMessageBox(0, _T("Fake dec_nv as msdk_dec"), _T("Test"), MB_OK);
	  pQyMc->cusModules.pMediaSdk_dec = pQyMc->cusModules.pDec_nv;
#endif

	  //
	  iErr = 0;

  errLabel:

#ifdef  __DEBUG__
	  traceLog((TCHAR*)_T("loadCusModule leaves %s"), iErr ? _T("failed") : _T("ok"));
#endif

	  return  iErr;
  }


  //
  int  initCusModules(void* pProcInfoParam)
  {
	  int						iErr = -1;

	  MC_VAR_common* pProcInfo = (MC_VAR_common*)pProcInfoParam;
	  if (!pProcInfo)  return  -1;
	  QY_MC* pQyMc = (QY_MC*)pProcInfo->pQyMc;
	  if (!pQyMc)  return  -1;

	  int						index = 0;
	  CUS_MODULE_U* pModule = NULL;

	  CQyRWLock		syncObj;
	  //
#if  0
	  if (syncObj.wLock(pQyMc->cfg.cusModules.mutexName, pQyMc->cfg.cusModules.uiMilliSeconds_mutex_w, pQyMc->hSema_syncCusModules, pQyMc->cfg.cusModules.uiMilliSeconds_sema_w, pQyMc->cfg.cusModules.uiInitCnt_sema))  return  -1;
#else
	  if (syncObj.wLock(pQyMc->pRw_syncCusModules, pQyMc->cfg.cusModules.uiMilliSeconds_sema_w))  return  -1;
#endif


	  for (index = 0; index < pQyMc->cusModules.usCnt; index++) {
		  pModule = &pQyMc->cusModules.mems[index];
		  //
		  //  if  (  !pModule->common.hModule  )  continue;
		  if (!pModule->common.bLoaded)  continue;

		  switch (pModule->common.uiType) {
		  case  CONST_moduleType_vDev:
			  if (pModule->vDev.pf_qyVDev_getCfg && pModule->vDev.pf_qyVDev_getCfg(0, 0, 0))  goto  errLabel;
			  if (pModule->vDev.pf_qyVDev_chkBeforeInit && pModule->vDev.pf_qyVDev_chkBeforeInit(0, 0, 0))  goto  errLabel;
			  if (pModule->vDev.pf_qyVDev_init && pModule->vDev.pf_qyVDev_init(0, 0, 0))  goto  errLabel;
			  pModule->vDev.ucbVDevInited = TRUE;
			  if (pModule->vDev.pf_qyVDev_chkAfterInit && pModule->vDev.pf_qyVDev_chkAfterInit(0, 0, 0))  goto  errLabel;
			  break;
		  case  CONST_moduleType_camCap: {
			  MODULE_camCap* pCamCap = (MODULE_camCap*)pModule;
			  if (pCamCap->pf_setGuiOpen)  pCamCap->pf_setGuiOpen(&pQyMc->guiOpen);
		  }
									   break;

		  case  CONST_moduleType_compress:
		  case  CONST_moduleType_ipp:
			  //
		  case  CONST_moduleType_mediaSdk_dec:
		  case  CONST_moduleType_mediaSdk_enc:
		  case  CONST_moduleType_mediaSdk_enc_conf:
			  //
		  case  CONST_moduleType_dec_nv:
		  case  CONST_moduleType_decD3d_nv:
		  case  CONST_moduleType_enc_nv:
		  case  CONST_moduleType_encD3d_nv:
			  //
		  case  CONST_moduleType_dec_amf:
		  case  CONST_moduleType_enc_amf:
			  //
		  case  CONST_moduleType_qdc_vorbis_dec:
		  case  CONST_moduleType_qdc_vorbis_enc:
			  //
		  case  CONST_moduleType_dec_vp8:
		  case  CONST_moduleType_enc_vp8:
			  //
		  case CONST_moduleType_ffmpeg:
			  //

		  default:
			  //
			  if (pModule->common.uiType == CONST_moduleType_decD3d_nv) {
				  int jj = 0;
			  }

			  //
			  pModule->compress.mgr.pGuiOpen = &pQyMc->guiOpen;
			  //
			  if (pModule->compress.pf_qdcInit && pModule->compress.pf_qdcInit(&pModule->compress.mgr))  goto  errLabel;
			  pModule->compress.ucbInited = TRUE;
			  break;
		  }
	  }


	  for (index = 0; index < pQyMc->cusModules.usCnt; index++) {
		  pModule = &pQyMc->cusModules.mems[index];
		  //
		  switch (pModule->common.uiType) {
		  case  CONST_moduleType_vDev:
			  if (pModule->vDev.ucbVDevInited) {
				  QY_VDEV* pVDev;

				  if (!(pVDev = (QY_VDEV*)pModule->vDev.pf_qyVDev_getPtrProperty(0, (void*)CONST_qyPropertyId_vDev, 0)))  goto  errLabel;

				  if (pQyMc->iServiceId == CONST_qyServiceId_is) {
#if  0
					  MC_VAR_isCli* pProcInfo = (MC_VAR_isCli*)pSci->pVar;
					  if (!pProcInfo)  goto  errLabel;

					  //  此标志的存在，是为了决定是否PhoneMsgrList下载。2008/02/01
					  if (pModule->vDev.pf_qyVDev_isSendable && pModule->vDev.pf_qyVDev_isSendable(0, (void*)CONST_objType_phoneMessenger, NULL))  pProcInfo->bPhoneModuleLoaded = TRUE;
					  //
#endif
				  }
				  break;
			  }
		  }
	  }

	  //  2014/12/06
