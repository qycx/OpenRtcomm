  int  mySetDebugStep(  void  *  p0,  DEBUG_step_common  *  pDebugStep,  int  nStep  )
{
	//
	if  (  !pDebugStep  )  return  -1;
	
	//		
	MACRO_setMyStep(  *pDebugStep,  nStep  );
	
	return  0;
}

 

