IDD_CSDEMOCLIENT_DIALOG DIALOGEX 0, 0, 296, 175
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
