    EDITTEXT        IDC_EDIT_APPFLAG,49,78,99,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "启动",IDOK,31,232,50,16
    PUSHBUTTON      "停止",IDC_BUTTON_STOP,98,232,50,16
    PUSHBUTTON      "关闭",IDCANCEL,172,232,50,16
    EDITTEXT        IDC_EDIT_STATUS,15,117,309,104,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    LTEXT           "端口",IDC_STATIC,155,57,17,8
    GROUPBOX        "运行信息",IDC_STATIC,6,104,326,122
    GROUPBOX        "调试器参数",IDC_STATIC,6,7,248,33
    LTEXT           "网关IP",IDC_STATIC,15,18,25,8
    LTEXT           "网关端口",IDC_STATIC,155,18,33,8
    GROUPBOX        "服务器参数",IDC_STATIC,6,45,248,52
    LTEXT           "IP",IDC_STATIC,15,57,9,8
    LTEXT           "应用标识",IDC_STATIC,15,79,33,8
    GROUPBOX        "通讯类型",IDC_STATIC,260,7,67,90
    CONTROL         "明文",IDC_RADIO_UNECRYPT,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,273,28,32,10
    CONTROL         "单向SSL",IDC_RADIO_SINGLE_SSL,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,273,47,44,10
END

