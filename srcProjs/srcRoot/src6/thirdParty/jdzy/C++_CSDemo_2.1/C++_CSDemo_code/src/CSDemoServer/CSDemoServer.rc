IDD_CSDEMOSERVER_DIALOG DIALOGEX 0, 0, 339, 255
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "集中认证C++ CSDemo（服务端）"
FONT 9, "宋体", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_IPADDRESS_GATEWAY,"SysIPAddress32",WS_TABSTOP,49,18,100,15
    EDITTEXT        IDC_EDIT_GATEWATPORT,197,18,49,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_IPADDRESS_SERVER,"SysIPAddress32",WS_TABSTOP,49,57,99,15
