
#include	"stdafx.h"
#include	"talkGuiExt_gui.h"

#include	"qyMcMainCommon.h"
#include	"dlgtalkproc.h"
#include	"talkExtTmpl.h"


//
int talk_refreshLayout_transmissionMode( HWND  hTalk, bool  bNoVDownload )
{
	int  iErr = -1;
	CCtxQyMc* pQyMc = g_pQyMc;
	CCtxQmc* pProcInfo = (CCtxQmc*)pQyMc->get_pProcInfo();

	do {
		//
		CHelp_getDlgTalkVar	help_getDlgTalkVar;
		DLG_TALK_var* pVar = (DLG_TALK_var*)help_getDlgTalkVar.getVar(hTalk, _T("dlgTalk_freeCapImgBySth_mgr"));
		if (!pVar) {
			break;
		}
		DLG_TALK_var& m_var = *pVar;


		//

		//  根据bNoVDownload来调整布局.

		//  然后，重绘hTalk;
		HWND  hCtrl;
		hCtrl = GetDlgItem(hTalk, m_var.guiData.iIDC_STATIC_peerDesc);
		//
		LONG_PTR  style = GetWindowLongPtr(hCtrl, GWL_STYLE);
		if (style & BS_OWNERDRAW) {
			int  ii = 0;
		}

		//
		if (0) {
			InvalidateRect(hCtrl, 0, true);
			UpdateWindow(hCtrl);
		}

		//
		RedrawWindow(hTalk, NULL, NULL,
			RDW_INVALIDATE |
			RDW_ALLCHILDREN |
			RDW_ERASE |
			RDW_UPDATENOW
		);


		//
		iErr = 0;

	} while (false);


	//
	return  iErr;
}




//
int TalkGuiExt_gui::refreshTransmissionMode(void* hDlgTalkParam, void* pm_var1)
{
	HWND  hDlgTalk = (HWND)hDlgTalkParam;
	DLG_TALK_var* pm_var = (DLG_TALK_var*)pm_var1;

	int					iErr = -1;
	CCtxQyMc* pQyMc = g_pQyMc;
	CCtxQmc* pProcInfo = (CCtxQmc*)pQyMc->get_pProcInfo();

	//
	do {
		CHelp_getDlgTalkVar	help_getDlgTalkVar;
		DLG_TALK_var* pMgrVar = (DLG_TALK_var*)help_getDlgTalkVar.getVar(hDlgTalk, _T("dlgTalk_freeCapImgBySth_mgr"));
		if (!pMgrVar) {
			break;
		}
		if (!isTalkerShadowMgr(pMgrVar->addr)) {
			break;
		}

		if (!pMgrVar->av.taskInfo.bTaskExists) {
			break;
		}
		//
		DLG_TALK_var& m_var = *pMgrVar;
		//
		int  iTaskId = pMgrVar->av.taskInfo.iTaskId;
		bool  bNoVDownload = pProcInfo->m_pTalkExt->bNoVDownload(iTaskId);



		//
		HWND  hMgr = hDlgTalk;

		TALKER_shadow_mgr* pShadowMgr; pShadowMgr = (TALKER_shadow_mgr*)pMgrVar->pShadowInfo;
		if (!pShadowMgr) {
			break;
		}

		int  i;
		for (i = 0; i < mycountof(pShadowMgr->shadows); i++) {
			if (pShadowMgr->shadows[i].hShadow) {
				talk_refreshLayout_transmissionMode(pShadowMgr->shadows[i].hShadow, bNoVDownload);
			}
		}

		//
		talk_refreshLayout_transmissionMode(hMgr, bNoVDownload);
		

		//
		//  发送chkTaskAlive来使mcu调整是否下发
		Param_sendTaskProcReq  param = { 0 };
		param.bNoVDownload = bNoVDownload;

		//
		sendTaskProcReq(&param, CONST_qyCmd_sendMedia, CONST_imOp_recv_applyForChkTaskAlive, m_var.av.taskInfo.tStartTime_org, m_var.av.taskInfo.uiTranNo_org, CONST_imCommType_transferAvInfo, m_var.addr.idInfo.ui64Id, m_var.addr.idInfo.ui64Id, m_var.av.taskInfo.iTaskId, 0, mynull, 0, true, _T("l236"), m_var.av.taskInfo.idInfo_starter.ui64Id);


		//
		iErr = 0;

	} while (false);

	//
	return  iErr;
 }
