			  }
			  //
			  M_getCompressModule(  &pQyMc->cusModules,  uiModuleType,  pModule  );	//  2012/09/09
			  if  (  !pModule  ||  !pModule->compress.pf_qdcInitDecompressAudio  )  {

				  _sntprintf(  tHintBuf,  mycountof(  tHintBuf  ),  _T(  "%s pModule or initDecA is null. moduleType %d"  ),  tHintBuf,  uiModuleType  );
