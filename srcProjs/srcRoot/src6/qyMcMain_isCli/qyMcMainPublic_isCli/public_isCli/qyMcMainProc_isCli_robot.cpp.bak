					  len  =  offsetof(  MIS_MSG_TASK,  data  )  +  pMsgInput->lenInBytes;
				  
					  pMsgInput->addr_logicalPeer.idInfo.ui64Id  =  pAddrTalkData->route.idInfo_from.ui64Id; 
				  
					  if  (  qPostMsg(  pMsgInput,  len,  &pQyMc->gui.processQ,  _T(  "procmsgInput_other_req"  ))) {
						  traceLogA(  (char*)  "mcThreadProc_mis_work(  ): qPostMsg(  ) failed"  );
						  goto  errLabel;
					  }
					  PostMessage(  pQyMc->gui.hMainWnd,  CONST_qyWm_postComm,  CONST_qyWmParam_msgArrive,  0  );    

					  break;
				  }


				  //
				  QIS_ptz_wnd  *  pPtzWnd  =  &pProcInfo->ptzWnd;
				 int	i;
				  //
#if 0
				  if  (  !pPtzWnd->m_var.cfg.bCfgInited  )  {
					  getPtzSettings(  &pPtzWnd->m_var.cfg  );
				  }
#endif
				  if  (  !pPtzWnd->m_var.cfg.bCfgInited  )  goto  errLabel;

				  //
				  if  (  pQyMc->iCustomId  ==  CONST_qyCustomId_bjyz  )  {
					  //  2017/08/29
					  }
				  else  {
						for  (  i  =  0;  i  <  mycountof(  pPtzWnd->m_var.cfg.idInfos_allowed  );  i  ++  )  {					   
							 if  (  !pPtzWnd->m_var.cfg.idInfos_allowed[i].ui64Id  )  continue;					   
							 if  (  pAddrTalkData->route.idInfo_from.ui64Id  ==  pPtzWnd->m_var.cfg.idInfos_allowed[i].ui64Id  )  break;				  
						}				  
						if  (  i  ==  mycountof(  pPtzWnd->m_var.cfg.idInfos_allowed  )  )  {					  
							qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "    procMsgInput_other_req: ptzControlReq, denied, %I64u"  ),  pAddrTalkData->route.idInfo_from.ui64Id  );					  
							showNotification(  NULL,  0,  &pAddrTalkData->route.idInfo_from,  0,  0,  0,  _T(  "ptzReq denied"  )  );  
							goto  errLabel;				  
						}
				  }
				  qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "    procMsgInput_other_req: ptzControlReq, permitted, %I64u"  ),  pAddrTalkData->route.idInfo_from.ui64Id  );
				  showNotification(  NULL,  0,  &pAddrTalkData->route.idInfo_from,  0,  0,  0,  _T(  "ptzReq permitted"  )  );  


				  
				  PTZ_control_req			reply;
				  memset(  &reply,  0,  sizeof(  reply  )  );
				  reply.uiType  =  pReq->uiType;
				  reply.ucbReply  =  TRUE;

				  //
				  reply.u.reply.tStartTime_org  =  pMsgInput->tStartTime;
				  reply.u.reply.uiTranNo_org  =  pMsgInput->uiTranNo;
				  //
				  lstrcpyn(  reply.u.reply.tHint,  pPtzWnd->m_var.cfg.tHint,  mycountof(  reply.u.reply.tHint  )  );

				  i  =  0;
				  reply.mems[i].nAddr  =  pPtzWnd->m_var.cfg.m_nAddr;
				  reply.mems[i].nPelcoType  =  pPtzWnd->m_var.cfg.m_pelcoType;
				  i  ++  ;

				  reply.usCnt  =  i;

				  MACRO_prepareForTran(  );

				  lenInBytes  =  sizeof(  reply  );

				  //
				  if  (  postMsg2Mgr_mc(  pMisCnt,  NULL,  CONST_misMsgType_outputTask,  0,  CONST_qyCmd_sendMedia, tStartTran,  uiTranNo,  0,  (  char  *  )&reply,  sizeof(  reply  ),  0,  &pAddrTalkData->route.idInfo_from,  pChannel->uiType,  NULL,  FALSE  )  )  traceLogA(  (char*)  "postMsg2Mgr_mc failed"  );


				  }
				  break;
			case  CONST_imCommType_ptzControlCmd:  {		//  2012/08/06
				  PTZ_control_cmd		*	pReq	=	NULL;

				  pReq  =  &pContent->ptzControlCmd;

				  //
				  QIS_ptz_wnd  *  pPtzWnd  =  &pProcInfo->ptzWnd;
				  int	i;

				  //
				  if (!pPtzWnd->m_var.cfg.bCfgInited) {
					  showInfo_open0(0, 0, _T("procMsgInput_other_req failed, 1649, ptz.bCfgInited false"));
					  goto  errLabel;
				  }

				  //
#if 0
				  if  (  pQyMc->iCustomId  ==  CONST_qyCustomId_bjyz  )  {
					  //  2017/08/26
					  }
				  else  {
					    //  
						for  (  i  =  0;  i  <  mycountof(  pPtzWnd->m_var.cfg.idInfos_allowed  );  i  ++  )  {
					   		 if  (  !pPtzWnd->m_var.cfg.idInfos_allowed[i].ui64Id  )  continue;
							 if  (  pAddrTalkData->route.idInfo_from.ui64Id  ==  pPtzWnd->m_var.cfg.idInfos_allowed[i].ui64Id  )  break;
				  		}
				  		if  (  i  ==  mycountof(  pPtzWnd->m_var.cfg.idInfos_allowed  )  )  {
							qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "    procMsgInput_other_req: ptzControlCmd, denied, %I64u"  ),  pAddrTalkData->route.idInfo_from.ui64Id  );
							showNotification(  NULL,  0,  &pAddrTalkData->route.idInfo_from,  0,  0,  0,  _T(  "ptzCmd denied"  )  );  
							goto  errLabel;				  
						}
				  }
				  TCHAR  tBuf[128]  =  _T(  ""  );
				  QY_DMITEM  *  pTable  =  getResTable(  0,  &pQyMc->cusRes,  CONST_resId_objTypeTable  );
				  if  (  !pTable  )  goto  errLabel;
				  _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "    procMsgInput_other_req: ptzControlCmd on camera (%s,%d.%d) permitted, from %I64u"  ),  qyGetDesByType1(  pTable,  pReq->cmdInfo.obj.uiObjType  ),  (  int  )pReq->cmdInfo.obj.usIndex_obj,  (  int  )pReq->cmdInfo.obj.usHelp_subIndex,  pAddrTalkData->route.idInfo_from.ui64Id  );				  
				  showInfo_open0(  0,  _T(  ""  ),  tBuf  );
				  showNotification(  NULL,  0,  &pAddrTalkData->route.idInfo_from,  0,  0,  0,  _T(  "ptzCmd permitted"  )  );  
#endif

				  //
				  if (pQyMc->appParams.bMcu) {
					  // 这里应该做以下校验云台操作授权的问题，合格就转发到云台终端
					  PTZ_control_cmd* pPcc = &pContent->ptzControlCmd;
					  
					  //
					  TCHAR  tBuf[128];
					  _sntprintf(tBuf, mycountof(tBuf), _T("procMsgInput_other_req1686: ptzCmd, %I64u->%I64u"), pAddrTalkData->route.idInfo_from.ui64Id, pPcc->cmdInfo.idInfo.ui64Id);
					  showInfo_open0(0, _T("mcu"), tBuf);

					  //
					  sendPtzReq(pPcc->cmdInfo.obj.uiObjType, pPcc->cmdInfo.obj.usIndex_obj, pPcc->cmdInfo.obj.usHelp_subIndex,
						  pPcc->cmdInfo.idInfo, pPcc->cmdInfo.iChannel, pPcc->cmdInfo.ucCmd, pPcc->cmdInfo.ucParam, pPcc->cmdInfo.ucMouseStatus, mynull,
						  pPcc->idInfo_imGrp_related, pPcc->cmdInfo.idInfo);
					  break;						  
				  }

				  //
				  pMsgInput->lenInBytes  =  min(  sizeof(  pMsgInput->data  ),  offsetof(  MIS_MSG_routeTalkData,  buf  )  +  sizeof(  PTZ_control_cmd  )  );
				  //
				  pMsgInput->uiType  =  CONST_misMsgType_task;
				  //
				  pMsgInput->idInfo_taskSender.ui64Id  =  pAddrTalkData->route.idInfo_from.ui64Id;
				  pMsgInput->idInfo_taskReceiver.ui64Id  =  pAddrTalkData->route.idInfo_to.ui64Id;
				  //
				  len  =  offsetof(  MIS_MSG_TASK,  data  )  +  pMsgInput->lenInBytes;
				  
				  pMsgInput->addr_logicalPeer.idInfo.ui64Id  =  pAddrTalkData->route.idInfo_from.ui64Id;
				  
				  if  (  qPostMsg(  pMsgInput,  len,  &pQyMc->gui.processQ,  _T(  "procMsgInput_other_req"  ))) {
					  #ifdef  __DEBUG__
							  traceLogA(  (char*)  "mcThreadProc_mis_work(  ): qPostMsg(  ) failed"  );
					  #endif
					  goto  errLabel;
				  }
				  PostMessage(  pQyMc->gui.hMainWnd,  CONST_qyWm_postComm,  CONST_qyWmParam_msgArrive,  0  );    

 
				  }
			      break;

				   //
			 default:
					//
					#ifdef  __DEBUG__
							_sntprintf( tBuf,mycountof(tBuf),_T("procMsgInput_other_req: unprocessed contentType %d [%s]"),  pContent->uiType,  qyGetDesByType1(  getResTable(  0,  &pQyMc->cusRes,  CONST_resId_qyCommTypeTable  ),  pContent->uiType  )  );
							showInfo_open0(0, 0, tBuf);
					#endif			
					//
					break;
	 }		 

	 iErr  =  0;

errLabel:

	 if  (  iErr  )  {
		 #if  0		//  2011/10/28. 出错就清理队列容易导致功能不稳定
		 #endif
	 }


	 return  iErr;
}


 int  procMsgInput_other_resp(  void  *  pQyMcParam,  void  *  pSgiParam,  MC_VAR_isCli  *  pProcInfo,  MIS_MSG_INPUT  *  pMsgInput,  unsigned  int  lenInBytes_msg,  void  *  pCTX_MC_THREAD,  MIS_CHANNEL  *  pChannel  )
{
	 int						iErr			=	-1;
	 QY_MC					*	pQyMc			=	(  QY_MC  *  )pQyMcParam;
	 QY_SERVICEGUI_INFO		*	pSci			=	(  QY_SERVICEGUI_INFO  *  )pSgiParam;
	 //
	 CTX_MC_THREAD  *  pCtx  =  (  CTX_MC_THREAD  *  )pCTX_MC_THREAD;
	 //
	 int						dataLen			=	0;
	 MIS_CNT				*	pMisCnt			=	NULL;
	 MIS_MSG_routeTalkData	*	pAddrTalkData	=	NULL;		
	 IM_CONTENTU			*	pContent		=	NULL;
	 unsigned  int				uiChannelType	=	CONST_channelType_robot;
	 //
	 if  (  !pCtx  )  {
		 traceLogA(  (char*)  "procMsgInput_other_resp failed: pCtx is null"  );
		 return  -1;
	 }

	 CQyMalloc					mallocObj;
	 MIS_MSG_INPUT			*	pMsg			=	(  MIS_MSG_INPUT  *  )pCtx->pMsgBuf_forInput;
	 if  (  !pMsg  )  {
		 #ifdef  __DEBUG__
				 traceLogA(  (char*)  "procMsgInput_other_resp: ctx.pMsgInput is null, need to malloc"  );
		 #endif
		 pMsg  =  (  MIS_MSG_INPUT  *  )mallocObj.mallocf(  sizeof(  MIS_MSG_INPUT  )  );			//  2007/12/02, ÕâÀï³öÏÖÁËÖØ¸´Ê¹ÓÃ£¬Ó¦¸Ã½«taskºÍinputµÈÏûÏ¢Ïë°ì·¨Í³Ò»ÆðÀ´£¬¾Í²»ÓÃ·´¸´×ª»»ÁË
	 }
	 if  (  !pMsg  )  return  -1;
	 //
	 int						lenInBytes		=	0;
	 //
	 TCHAR						tHintBuf[255  +  1]		=	_T(  ""  );
	 TCHAR						tBuf[255  +  1]			=	_T(  ""  );
	 BOOL						bRemoveIfErr			=	TRUE;
	 //  2008/11/19
	 MSG_ROUTE					route;
	 unsigned  char				ucFlg					=	0;


#ifdef  __DEBUG__
	 //
#if  0
	 if  (  sizeof(  pMsgInput->data  )  <  sizeof(  MIS_MSG_TALKDATA  )  )  {
		 traceLogA(  (char*)  "procMsgInput_mgr_resp:  pMsgInput->buf size {%d}  >=  sizeof(  IM_CONTENTU  ) {%d}",  sizeof(  pMsgInput->data  ),  sizeof(  IM_CONTENTU  )  );
		 goto  errLabel;
	 }
#endif 
//
#endif

	 pMisCnt  =  (  MIS_CNT  *  )pMsgInput->pMisCnt;

	 if  (  !isUcFlgResp(  pMsgInput->ucFlg  )  )  goto  errLabel;
 

	 if  (  !pMsgInput->ucbConvrted  )  {
		   	 MACRO_memset_misMsgInput(  pMsg  );
	 		 memcpy(  pMsg,  pMsgInput,  offsetof(  MIS_MSG_INPUT,  data  )  );  

			 if  (  
				 //isUcFlgTalkData(  pMsgInput->ucFlg  )  ||  
				 isUcFlgRouteTalkData(  pMsgInput->ucFlg  )  )  {
				 pAddrTalkData	=	(  MIS_MSG_routeTalkData  *  )&pMsg->data;			 
				 //
				 if  (  qyntohRouteTalkData(  pMsgInput->ucFlg,  (  char  *  )&pMsgInput->data,  pMsgInput->lenInBytes,  &pMsg->data.route,  (  IM_CONTENTU  *  )pMsg->data.buf,  tHintBuf,  mycountof(  tHintBuf  )  )  )  {
					 qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "    qyntohRouteTalkData failed. %s"  ),  tHintBuf  );
					 goto  errLabel;    
				 }
				 if  (  tHintBuf[0]  )  qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "    %s"  ),  tHintBuf  );
				 //
				 if  (  getIdInfo_logicalPeer(  pSci,  pMisCnt,  &pAddrTalkData->route,  &pMsg->addr_logicalPeer  )  )  goto  errLabel;
				 //			 
				 }
			 else  {
				   if  (  pMsgInput->usCode  ==  CONST_qyRc_servBusy  )  {
					    qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "Server returns: %s"  ),  qyGetDesByType1(  CONST_qyRcTable,  pMsgInput->usCode  )  );
						iErr  =  0;  goto  errLabel;
				   }
				   if  (  pMsgInput->lenInBytes  <  sizeof(  unsigned  int  )  )  {	//  Ö¸Ã»ÓÐcontentType
					   qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "Failed:  Server returns: %s"  ),  qyGetDesByType1(  CONST_qyRcTable,  pMsgInput->usCode  )  );
					   goto  errLabel;
				   }

				   if  (  qyntohRouteTalkData(  pMsgInput->ucFlg,  (  char  *  )&pMsgInput->data,  pMsgInput->lenInBytes,  NULL,  (  IM_CONTENTU  *  )&pMsg->data,  tHintBuf,  mycountof(  tHintBuf  )  )  )  {
						qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "qyntohRouteTalkData failed. %s"  ),  tHintBuf  );
						goto  errLabel;    
				   }

				   if  (  tHintBuf[0]  )  qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "%s"  ),  tHintBuf  );
				   //		   
			 }
		   	 pMsg->ucbConvrted  =  TRUE;
			 //
			 pMsgInput  =  pMsg;
	 }

	 pAddrTalkData  =  MACRO_msgRouteTalkData(  pMsgInput->ucFlg,  &pMsgInput->data  );
	 if  (  !pAddrTalkData  )  {
		 traceLogA(  (char*)  "procMsgInput_other_resp failed: pAddrTalkData is null"  );  
		 goto  errLabel;
	 }

	 //
	 pContent  =  M_getMsgContent(  pMsgInput->ucFlg,  &pMsgInput->data  );
	 if  (  !pContent  )  goto  errLabel;


	 #ifdef  __DEBUG__
			 pAddrTalkData->route.debugInfo.dwTickCnt_resp_recved  =  GetTickCount(  );
	 #endif

	 //
	 if  (  pQyMc->env.bDebugInfo  &&  pProcInfo->cfg.debugStatusInfo.ucbViewIoStatus  )  {		
		 TCHAR		who_from[32  +  1]	=	_T(  ""  );
		 LPCTSTR	where_showInfo		=  qyGetDesByType1(  CONST_channelTypeTable,  pChannel->uiType  );
		 int		iAfter				=	GetTickCount(  )  -  pMsgInput->dwTickCnt_start;
		 //
		 _sntprintf(  who_from,  mycountof(  who_from  ),  _T(  "%I64u"  ),  pAddrTalkData->route.idInfo_from.ui64Id  );
		 if  (  isUcFlgResp(  pMsgInput->ucFlg  )  )  _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "  tn %d, resp: %s, dataLen %d, iAfter_recvd %d."  ),  pMsgInput->uiTranNo,  qyGetDesByType1(  CONST_qyRcTable,  pMsgInput->usCode  ),  pMsgInput->lenInBytes,  iAfter  );
		 else  _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  " tn %d, req: %s, dataLen %d, iAfter_recvd %d."  ),  pMsgInput->uiTranNo,  qyGetDesByType1(  CONST_qyCmdTable,  pMsgInput->usCode  ),  pMsgInput->lenInBytes,  iAfter  );
		 if  (  pMsgInput->data.route.debugInfo.index  )  _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "%s index %d"  ),  tBuf,  pMsg->data.route.debugInfo.index  );

		 qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  who_from,  pProcInfo->who_showInfo,  where_showInfo,  _T(  ""  ),  _T(  "%s"  ),  tBuf  );
	 }

	 //  ÏÂÃæ´¦ÀíÏìÓ¦
	 //	
	 switch  (  pContent->uiType  )  {
			 case  CONST_imCommType_simpleResp:  {  

				   traceLogA(  (char*)  "procMsgInput_robot_resp: %S, %S",  qyGetDesByType1(  CONST_qyCmdTable,  pContent->simpleResp.usCmd_org  ),  qyGetDesByType1(  CONST_qyRcTable,  pMsgInput->usCode  )  );

				   if  (  !pAddrTalkData  )  goto  errLabel;
				   if  (  !pCtx->pProcessQ  )  goto  errLabel;

				   //
				   //printQ_mis(  &pCtx->pProcessQ->m_q,  0  );
				   //
				   printMisMsg(  0,  0,  (  MIS_MSGU  *  )pMsgInput  );

				   switch  (  pContent->simpleResp.usCmd_org  )  {
						   case  CONST_qyCmd_sendRobotTaskReply:  {
							     //
								 MACRO_prepareForTran(  );

								 //
							     TRANSFER_FILEDATA_REQ	req;

								 memset(  &req,  0,  sizeof(  req  )  );
								 req.uiType  =  CONST_imCommType_transferFileDataReq;
								 //
								 req.tmpInternal.tStartTime_new  =  tStartTran;
								 req.tmpInternal.uiTranNo_new  =  uiTranNo;
								 //
								 if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  &req  )  <=  0  )  goto  errLabel;
								 lenInBytes  =  sizeof(  req  );

								 //
								 #ifdef  __DEBUG__
										 traceLogA(  (char*)  ""  );
								 #endif
								 if  (  startChannel(  pProcInfo,  pMisCnt,  pChannel,  _T(  "robot channel"  )  )  )  {
									 traceLogA(  (char*)  "robot Channel"  );  
									 goto  errLabel;
								 }


								 //
#ifdef ORG_FILE_SEND_LOGIC

								 if  (req.us_nBlocks > 0 && postMsg2Mgr_mc(  pMisCnt,  NULL,  CONST_misMsgType_outputTask,  0,  CONST_qyCmd_sendRobotTaskData, tStartTran,  uiTranNo,  0,  (  char  *  )&req,  lenInBytes,  &pMsgInput->addr_logicalPeer.idInfo,  &pAddrTalkData->route.idInfo_from,  uiChannelType,  NULL,  FALSE  )  )  goto  errLabel;
								 }
#else
								 if (postMsg2Mgr_mc(pMisCnt, NULL, CONST_misMsgType_outputTask, 0, CONST_qyCmd_sendRobotTaskData, tStartTran, uiTranNo, 0, (char*)&req, lenInBytes, &pMsgInput->addr_logicalPeer.idInfo, &pAddrTalkData->route.idInfo_from, uiChannelType, NULL, FALSE))  goto  errLabel;
				   }
#endif
							     break;
						   case  CONST_qyCmd_sendMedia:  {

							     if  (  pContent->simpleResp.uiContentType_org  ==  CONST_imCommType_transferAvReplyInfo  )  {
									 if  (  !isRcOk(  pMsgInput->usCode  )  )  {
										 traceLogA(  (char*)  "rc is not ok"  );  goto  errLabel;
									 }

									 if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  NULL  )  <=  0  )  goto  errLabel;

									 traceLogA(  (char*)  ""  );
									 if  (  startChannel(  pProcInfo,  pMisCnt,  pChannel,  _T(  ""  )  )  )  {
										 traceLogA(  (char*)  "start Media Channel Failed."  );  goto  errLabel;
									 }
								 }

								 //  traceLogA(  (char*)  "ÕâÀï£¬ËÆºõÓ¦¸Ã×öÊÓÆµ´¦Ê¼»¯µÄ¹¤×÷¡£µÈÆô¶¯ÁËÊÓÆµ¼à¿Ø£¬ÔÚÓÐÊÓÆµÊý¾ÝÊ±£¬×ÔÈ»£¬¾Í·¢ËÍ¹ýÈ¥ÁË"  );

							     }
							     break;
						   default:
									break;
				   }

				   }
				   break;
			 case  CONST_imCommType_taskProcResp:  {

				   bRemoveIfErr  =  FALSE;

				   if  (  !pAddrTalkData  )  goto  errLabel;
				   if  (  !pCtx->pProcessQ  )  goto  errLabel;

				   #if  0
				   if  (  pContent->taskProcResp.idInfo_logicalPeer.ui64Id  )  {
					   traceLogA(  (char*)  "procMsgInput_other_resp: taskProcResp, use idInfo_logicalPeer to set idInfo_to"  );
					   pAddrTalkData->route.idInfo_to.ui64Id  =  pContent->taskProcResp.idInfo_logicalPeer.ui64Id;
					   pContent->taskProcResp.idInfo_logicalPeer.ui64Id  =  0;				  
					   //
					   if  (  getIdInfo_logicalPeer(  pSci,  pMisCnt,  &pAddrTalkData->route,  &pMsgInput->addr_logicalPeer  )  )  goto  errLabel;				 
				   }
				   #endif

				  #if  10
				  if  (  pContent->taskProcResp.idInfo_logicalPeer.ui64Id  )  {
					  if  (  pContent->taskProcResp.idInfo_logicalPeer.ui64Id  ==  pMisCnt->idInfo.ui64Id  )  {
						  //  2015/06/08
						  pMsgInput->addr_logicalPeer.idInfo.ui64Id  =  pMsgInput->data.route.idInfo_from.ui64Id;
						  pContent->taskProcResp.idInfo_logicalPeer.ui64Id  =  0;
						  }
					  else  {
						    pMsgInput->addr_logicalPeer.idInfo.ui64Id  =  pContent->taskProcResp.idInfo_logicalPeer.ui64Id;
					  }
				  }
				  #endif


				   if  (  qPostMsg(  pMsgInput,  offsetof(  MIS_MSG_INPUT,  data  )  +  offsetof(  MIS_MSG_routeTalkData,  buf  )  +  sizeof(  pContent->taskProcResp  ),  &pQyMc->gui.processQ,  _T(  "procMsgInput_other_resp"  ))) {
					   #ifdef  __DEBUG__
							   traceLogA(  (char*)  "procMsgInput_other_resp(  ): qPostMsg(  ) failed"  );  
					   #endif
					   goto  errLabel;
				   }			
				   PostMessage(  pQyMc->gui.hMainWnd,  CONST_qyWm_postComm,  CONST_qyWmParam_msgArrive,  0  );    

				   }
				   break;
			 case  CONST_imCommType_transferFileDataResp:  {
				   //
				   #ifdef  __DEBUG__
						   traceLogA(  (char*)  "procMsgInput_robot_resp:  transferFileDataResp"  );
						   //
						   if (1) {
							   _sntprintf(tBuf, mycountof(tBuf), _T("get fileDataResp from %I64u, dataBlock %d, len %d"), pMsgInput->data.route.idInfo_from.ui64Id,
								   pContent->transferFileDataResp.uiDataBlockIndex, pContent->transferFileDataResp.uiLen);
							   showInfo_open0(0, 0, tBuf);
						   }
				   #endif

				   //
				   bRemoveIfErr  =  FALSE;	//  2010/12/05

				   if  (  !pCtx->pProcessQ  )  goto  errLabel;
				   //
				   //printQ_mis(  &pCtx->pProcessQ->m_q,  0  );
				   //
				   printMisMsg(  0,  0,  (  MIS_MSGU  *  )pMsgInput  );

				   //
				   MACRO_prepareForTran(  );

				   //

				   TRANSFER_FILEDATA_REQ  req;
				   memset(  &req,  0,  sizeof(  req  )  );
				   req.uiType  =  CONST_imCommType_transferFileDataReq;
				   //
				   req.tmpInternal.tStartTime_new  =  tStartTran;
				   req.tmpInternal.uiTranNo_new  =  uiTranNo;
				   //
				   if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  &req  )  <=  0  )  {
					   _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "fileDataResp err: from %I64u, tn %d. no matched task"  ), 
						   pMsgInput->data.route.idInfo_from.ui64Id,  pMsgInput->uiTranNo  );
					   showInfo_open0(  0,  0,  tBuf  );
					   //
#ifdef  __DEBUG__
					   traceLog((TCHAR*)_T("procMsgInput_other_resp failed: %s"), tBuf);
#endif 
					   //
					   goto  errLabel;
				   }
				   lenInBytes  =  sizeof(  req  );
			   
				   startChannel(  pProcInfo,  pMisCnt,  pChannel,  _T(  "proc transferFileDataResp"  )  );
				   
				   //
				   ucFlg  =  0;
				   memset(  &route,  0,  sizeof(  route  )  );
				   route.idInfo_from.ui64Id  =  pMisCnt->idInfo.ui64Id;
				   if  (  1  )  {
					   ucFlg  |=  CONST_commFlg_routeTalkData;
					   route.debugInfo.dwTickCnt_me_start  =  GetTickCount(  );	
					   time_t	tNow;	mytime(  &tNow  );  route.debugInfo.tTime_start  =  tNow;
				   }

				   if  (  !req.tmpInternal.ucbFileEnd  )  {

					   //
					   if (  pProcInfo->cfg.debugStatusInfo.ucbViewFileStatus  )  {
						   _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "send fileDataReq.dataBlockIndex %d, sizePerSnd %d, tn %d, to %I64u. channel %s"  ),  req.uiDataBlockIndex,  req.uiSizePerSnd,  uiTranNo,  pAddrTalkData->route.idInfo_from.ui64Id,  qyGetDesByType1(  CONST_channelTypeTable,  uiChannelType  )  );  
						  showInfo_open0(  0,  0,  tBuf  );
					   }

					   //  2008/11/19.
					   route.debugInfo.index  =  req.uiDataBlockIndex;

#ifdef ORG_FILE_SEND_LOGIC

					   if  (req.us_nBlocks > 0 &&  postMsg2Mgr_mc(  pMisCnt,  &route,  CONST_misMsgType_outputTask,  ucFlg,  CONST_qyCmd_sendRobotTaskData, tStartTran,  uiTranNo,  0,  (  char  *  )&req,  lenInBytes,  &pMsgInput->addr_logicalPeer.idInfo,  &pAddrTalkData->route.idInfo_from,  uiChannelType,  NULL,  FALSE  )  )  goto  errLabel;
#else
					   if (postMsg2Mgr_mc(pMisCnt, &route, CONST_misMsgType_outputTask, ucFlg, CONST_qyCmd_sendRobotTaskData, tStartTran, uiTranNo, 0, (char*)&req, lenInBytes, &pMsgInput->addr_logicalPeer.idInfo, &pAddrTalkData->route.idInfo_from, uiChannelType, NULL, FALSE))  goto  errLabel;
#endif
					   break;
				   }
				   
				   #ifdef  __DEBUG__
						   traceLogA(  (char*)  "procMsgInput_other_resp: send transferFileEndReq"  );
				   #endif
				   TRANSFER_FILEEND_REQ	endReq;
				   memset(  &endReq,  0,  sizeof(  endReq  )  );
				   endReq.uiType  =  CONST_imCommType_transferFileEndReq;
				   //  2015/09/07
				   endReq.tmpInternal.bChkToRemove_i  =  TRUE;
				   //
				   //  if  (  pCtx->pProcessQ->qRemoveMsg(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  &endReq  )  )  goto  errLabel;
				   if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  &endReq  )  <=  0  )  goto  errLabel;
				   //  2015/09/08
				   if  (  endReq.tmpInternal.bNeedRemoved_o  )  {
					   qmcApplyForRemovingInvalidTasks(  pProcInfo,  0  );
				   }
				   //
				   lenInBytes  =  sizeof(  endReq  );
				   //
				   route.debugInfo.index  =  -1;	// 

				   //
				   uiChannelType = 0;

				   //
				   if  (  postMsg2Mgr_mc(  pMisCnt,  &route,  CONST_misMsgType_outputTask,  ucFlg,  CONST_qyCmd_sendRobotTaskData,  tStartTran,  uiTranNo,  0,  (  char  *  )&endReq,  lenInBytes,  &pMsgInput->addr_logicalPeer.idInfo,  &pAddrTalkData->route.idInfo_from,  uiChannelType,  NULL,  FALSE  )  )  goto  errLabel;
				   }
				   break;							     

			 case  CONST_imCommType_transferVideoDataResp:

				   bRemoveIfErr  =  FALSE;

				   if  (  !pCtx->pProcessQ  )  goto  errLabel;
				   if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  0  )  <=  0  )  {
					   #ifdef  __DEBUG__
							   showInfo_open0(  0,  0,  _T(  "Err: videoDataResp not mateched"  )  );
					   #endif
					   goto  errLabel;
				   }
				   
				   break;

			 case  CONST_imCommType_transferAudioDataResp:

				   bRemoveIfErr  =  FALSE;

				   if  (  !pCtx->pProcessQ  )  goto  errLabel;
				   if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  0  )  <=  0  )  {
					   #ifdef  __DEBUG__
							   showInfo_open0(  0,  0,  _T(  "Err: audioDataResp not mateched"  )  );
					   #endif
					   goto  errLabel;
				   }
				   
				   break;

			 case  CONST_imCommType_transferGpsDataResp:
				   bRemoveIfErr  =  FALSE;

				   if  (  !pCtx->pProcessQ  )  goto  errLabel;
				   if  (  pCtx->pProcessQ->qTraverse(  tmpHandler_findOrgMsgAndProc_is,  pMsgInput,  0  )  <=  0  )  {
					   #ifdef  __DEBUG__
							   showInfo_open0(  0,  0,  _T(  "Err: gpsDataResp not mateched"  )  );
					   #endif
					   goto  errLabel;
				   }

				   break;

			 default:
					#if  1
							_sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "procMsgInput_other_resp(  ):  unprocessed contentType %d, cmd_org %s\n"  ),  pContent->uiType,  qyGetDesByType1(  CONST_qyCmdTable,  pMsgInput->usCode_org  )  );
							OutputDebugString(  tBuf  );
							showInfo_open0(  0,  0,  tBuf  );
					#endif
					break;
	 }								
	 
								   
	 //
	 iErr  =  0;

errLabel:

	 if  (  iErr  )  {
#if  0	 //  2011/10/28, 出错就清理队列，容易导致不稳定
#endif
	 }
	 return  iErr;
}






//  2013/08/27
BOOL  isTooManyThreads(  )
{
	MC_VAR_isCli	*	pProcInfo	=	QY_GET_procInfo_isCli(  );

	if  (  pProcInfo->status.nThreads_dec  +  pProcInfo->status.nThreads_dispatch  >  pProcInfo->cfg.policy.usMax_nThreads_dec  )  {
		TCHAR	tBuf[128]	=	_T(  ""  );
		_sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "Fail: too many threads.>%d"  ),  pProcInfo->cfg.policy.usMax_nThreads_dec  );
		showNotification(  NULL,  NULL,  NULL,  0,  0,  0,  tBuf  );
		return  TRUE;
	}
	return  FALSE;
}





 //////////////////////////

  int  stopDispatchThreads(  PROC_TASK_AV  *  pTask  )
{
	MC_VAR_isCli  *  pProcInfo	=	QY_GET_procInfo_isCli(  );
	int		i;
	
	if  (  !pTask->pDispatchs  )  return  0;

	for  (  i  =  0;  i  <  pTask->usCntLimit_dispatchs;  i  ++  )  {
		 QIS_DISPATCH	*	p	=	&pTask->pDispatchs[i];

		 if  (  p->audio.hThread  )  {
			 p->audio.bQuit  =  TRUE;
			 //
			 SetEvent(  p->audio.q2.hEvents[0]  );
			 waitForObject(  &p->audio.hThread,  20000  );
			 if  (  p->audio.hThread  )  {
				 qyExitProcess(  _T(  "stopDispatchThreads failed: can't wait for audio thread."  )  );
				 }
			 else  {
				   InterlockedDecrement(  &pProcInfo->status.nThreads_dispatch  );
			 }

		 }
		 if  (  p->video.hThread  )  {
			 p->video.bQuit  =  TRUE;
			 //
			 SetEvent(  p->video.q2.hEvents[0]  );
			 waitForObject(  &p->video.hThread,  20000  );
			 if  (  p->video.hThread  )  {
				 qyExitProcess(  _T(  "stopDispatchThreads failed: can't wait for video thread."  )  );
				 }
			 else  {
				   InterlockedDecrement(  &pProcInfo->status.nThreads_dispatch  );
			 }
		 }
	}		 

	traceLogA(  (char*)  "stopDispatchThreads"  );

	return  0;
}

 int  startDispatchThreads(  PROC_TASK_AV  *  pTask  )
{
	int		iErr	=	-1;
	DWORD	dwThreadDaemonId;
	MC_VAR_isCli	*	pProcInfo	=	QY_GET_procInfo_isCli(  );
	TCHAR				tHintBuf[128]	=	_T(  ""  );

	int		i;

	if  (  !pTask->pDispatchs  )  return  -1;

	//
	if  (  isTooManyThreads(  )  )  {
		_sntprintf(  tHintBuf,  mycountof(  tHintBuf  ),  _T(  "too many dec threads"  )  );
		goto  errLabel;
	}

	//
	for  (  i  =  0;  i  <  pTask->usCntLimit_dispatchs;  i  ++  )  {
		 QIS_DISPATCH	*	p	=	&pTask->pDispatchs[i];

		 if  (  !p->audio.hThread  )  {
			 //
			 p->audio.bQuit  =  FALSE;
			 p->audio.hThread  =  CreateThread(  NULL,  0,  mcThreadProc_dispatchAudio,  p,  CREATE_SUSPENDED,  &dwThreadDaemonId  );
			 if  (  !p->audio.hThread  )  goto  errLabel;					
			 p->audio.dwThreadId  =  dwThreadDaemonId;			
			 if  (  ResumeThread(  p->audio.hThread  )  ==  -1  )  goto  errLabel;									 

			 //  2013/08/27
			 InterlockedIncrement(  &pProcInfo->status.nThreads_dispatch  );
		 }				
		 if  (  !p->video.hThread  )  {
			 //
			 p->video.bQuit  =  FALSE;
			 p->video.hThread  =  CreateThread(  NULL,  0,  mcThreadProc_dispatchVideo,  p,  CREATE_SUSPENDED,  &dwThreadDaemonId  );
			 if  (  !p->video.hThread  )  goto  errLabel;					
			 p->video.dwThreadId  =  dwThreadDaemonId;			
			 if  (  ResumeThread(  p->video.hThread  )  ==  -1  )  goto  errLabel;	

			 //  2013/08/27
			 InterlockedIncrement(  &pProcInfo->status.nThreads_dispatch  );
		 }
	}

	iErr  =  0;
errLabel:

	
	if  (  iErr  )  {
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  _T(  "IsClient"  ),  0,  _T(  ""  ),  _T(  ""  ),  _T(  "startDispatchThreads failed, %s"   ),  tHintBuf  );
	}

#ifdef  __DEBUG__
		traceLogA(  (char*)  "startDispatchThreads leaves with %s",  iErr  ?  "failed"  :  "Ok"  );
#endif


	return  iErr;
}


 void  exitDispatch_qis(  PROC_TASK_AV  *  pTask  );

 //  2009/06/16
 int  initDispatch_qis(  MC_VAR_isCli  *  pProcInfo,  MSGR_ADDR  *  pAddr_logicalPeer,  int  iTaskId,  AV_TRAN_INFO  *  pTranInfo,  PROC_TASK_AV  *  pTask  )
{
	int		iErr	=	-1;
	QY_MC	*	pQyMc	=	(  QY_MC  *  )pProcInfo->pQyMc;
	int			i;
	int			len;

	if  (  !pTask->usCntLimit_dispatchs  )  return  0;
	if  (  pTask->pDispatchs  )  return  -1;

	len  =  pTask->usCntLimit_dispatchs  *  sizeof(  QIS_DISPATCH  );
	pTask->pDispatchs  =  (  QIS_DISPATCH  *  )mymalloc(  len  );
	if  (  !pTask->pDispatchs  )  goto  errLabel;
	memset(  pTask->pDispatchs,  0,  len  );

	for  (  i  =  0;  i  <  pTask->usCntLimit_dispatchs;  i  ++  )  {
		 QIS_DISPATCH	*	p	=	&pTask->pDispatchs[i];
		 GENERIC_Q_CFG		tmpCfg;

		 memcpy(  &tmpCfg,  &pProcInfo->cfg.dispatchQ,  sizeof(  tmpCfg  )  );
		 _sntprintf(  tmpCfg.name,  mycountof(  tmpCfg.name  ),  _T(  "%s-a-%d-%d"  ),  tmpCfg.name,  iTaskId,  i  );
		 _sntprintf(  tmpCfg.mutexName_prefix,  mycountof(  tmpCfg.mutexName_prefix  ),  _T(  "%s-a-%d-%d"  ),  tmpCfg.mutexName_prefix,  iTaskId,  i  );

		 if  (  initQyQ2(  &tmpCfg,  &pQyMc->cfg.rwLockParam,  mycountof(  p->audio.q2.hEvents  ),  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  &p->audio.q2  )  )  goto  errLabel;
		 p->audio.bQInited  =  TRUE;

		 //
		 memcpy(  &tmpCfg,  &pProcInfo->cfg.dispatchQ,  sizeof(  tmpCfg  )  );
		 _sntprintf(  tmpCfg.name,  mycountof(  tmpCfg.name  ),  _T(  "%s-v-%d-%d"  ),  tmpCfg.name,  iTaskId,  i  );
		 _sntprintf(  tmpCfg.mutexName_prefix,  mycountof(  tmpCfg.mutexName_prefix  ),  _T(  "%s-v-%d-%d"  ),  tmpCfg.mutexName_prefix,  iTaskId,  i  );
		 if  (  initQyQ2(  &tmpCfg,  &pQyMc->cfg.rwLockParam,  mycountof(  p->video.q2.hEvents  ),  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  &p->video.q2  )  )  goto  errLabel;
		 p->video.bQInited  =  TRUE;	

		 p->pProcInfo  =  pProcInfo;	
		 p->pAddr_logicalPeer  =  pAddr_logicalPeer;
		 p->iTaskId  =  iTaskId;
		 p->pTranInfo  =  pTranInfo;
		 p->pTask  =  pTask;
		 //
		 p->index_activeMems_from  =  i;

	}

	if  (  startDispatchThreads(  pTask  )  )  goto  errLabel;

	iErr  =  0;
errLabel:

	if  (  iErr  )  {
		exitDispatch_qis(  pTask  );
	}

	return  iErr;
}


 void  exitDispatch_qis(  PROC_TASK_AV  *  pTask  )
{
	int  i;

	if  (  !pTask->pDispatchs  )  return;

	stopDispatchThreads(  pTask  );

	for  (  i  =  0;  i  <  pTask->usCntLimit_dispatchs;  i  ++  )  {
		 QIS_DISPATCH	*	p	=	&pTask->pDispatchs[i];

		 //
		 if  (  p->audio.bQInited  )  exitQyQ2(  &p->audio.q2  );
		 if  (  p->video.bQInited  )  exitQyQ2(  &p->video.q2  );		 
	}

	free(  pTask->pDispatchs  );  pTask->pDispatchs  =  NULL;

	return;
}

 int  initMisMsg(  void  *  p_msg  )
{
	int								iErr				=	-1;
	TASK_common * pTaskParam=(TASK_common*)p_msg;
	// 
	QY_MC					*		pQyMc				=	QY_GET_GBUF(  );
	if  (  pQyMc->iServiceId  !=  CONST_qyServiceId_mis  )  return  -1;
	QY_SERVICEGUI_INFO		*		pSci				=	getServiceGuiInfo(  pQyMc,  pQyMc->iServiceId  );
	if  (  !pSci  )  return  -1;
	MC_VAR_isCli				*		pProcInfo			=	(  MC_VAR_isCli  *  )pSci->pVar;
	if  (  !pProcInfo  )  return  -1;
	//  int								index;
	//int								i1;

	//
	QMC_TASK_INFO * pTaskInfo=(QMC_TASK_INFO*)getQmcTaskInfoByIndex(pProcInfo, pTaskParam->m_index_taskInfo);
	if(pTaskInfo==NULL)return -1;

	MIS_MSGU * pMsg=&pTaskInfo->var.pTaskData->msgU;
#ifdef  __DEBUG__
	traceLogA(  (char*)  "initMisMsg enters"  );
#endif
	if  (  GetCurrentThreadId(  )  !=  pQyMc->gui.ctx_gui_thread.dwThreadId  )  {
		showInfo_open0(  0,  0,  _T(  "initMisMsg failed, not thread_mgr"  )  );
		#ifdef  __DEBUG__
				MACRO_qyAssert(  0,  _T(  "initMisMsg failed, not thread_mgr"  )  );
		#endif
		return  -1;
	}

	//
	switch  (  pMsg->uiType  )  {
			case  CONST_misMsgType_task:  {
				  IM_CONTENTU	*	pContent	=	M_getMsgContent(  pMsg->task.ucFlg,  &pMsg->task.data  );
				  if  (  !pContent  )  goto  errLabel;

				  switch  (  pContent->uiType  )  {
						  case  CONST_imCommType_transferAvInfo:  {
							  if  (  pTaskInfo->var.pTaskData->uiType  !=  CONST_taskDataType_conf  )  goto  errLabel;
							  QMC_taskData_conf  *  pTc  =  (  QMC_taskData_conf  *  )pTaskInfo->var.pTaskData;

							  //								
							  TASK_transferAv * task=(TASK_transferAv*)pTaskParam;
							  PROC_TASK_AV	*	pTask		=	&task->myTask;								
							  if  (  !pTask  )  goto  errLabel;
							  
							  //								
							  pTask->iIndex_taskInfo  =  task->m_index_taskInfo;

							  //
							  assert(  !pTc->videoConference.pMems_from  );

							  //
							  if(!pTaskInfo->var.m_bReplyTask) {
							    //
							    if  (  pContent->transferAvInfo.tmp_usSubtype  !=  CONST_transferAvInfo_subtype_task  )  {
									//  2016/04/18
									#ifdef  __DEBUG__
											MACRO_qyAssert(  0,  _T(  "transferAvInfo.subtype err, not task"  )  );
									#endif
									goto  errLabel;
								}
								//
							    AV_TRAN_INFO	*	pAvTran		=	&pContent->transferAvInfo.ass.tranInfo;


								//  2014/08/04
								pTask->saveVideo.uiObjType  =  pContent->transferAvInfo.ass.resObj.uiObjType;			//  2014/08/08
								pTask->saveVideo.usIndex_obj  =  pContent->transferAvInfo.ass.resObj.usIndex_obj;
								pTask->saveVideo.ucbSaveVideo_req  =  pContent->transferAvInfo.viewDynBmp.ucbSaveVideo;

								//
								if  (  !pTc->videoConference.usCntLimit_mems_from  ||  pTc->videoConference.usCntLimit_mems_from  >  MAX_mems_taskAv  )  goto  errLabel;

								//  2008/11/16
								HDC hScreenDC=::GetDC(NULL);
								pTask->remoteAssist.maxxScreen = GetDeviceCaps(hScreenDC,HORZRES);
								pTask->remoteAssist.maxyScreen = GetDeviceCaps(hScreenDC,VERTRES);
								::ReleaseDC(NULL,hScreenDC);		
								//
								if  (  !pTask->remoteAssist.maxxScreen  ||  !pTask->remoteAssist.maxyScreen  )  goto  errLabel;

								//  2009/02/16
								pTc->videoConference.pMems_from  =  (  TASK_AV_FROM  *  )mymalloc(  pTc->videoConference.usCntLimit_mems_from  *  sizeof(  TASK_AV_FROM  )  );
								if  (  !pTc->videoConference.pMems_from  )  {
									qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg: malloc for avInfo.pMems_from failed"   )  );
									goto  errLabel;
								}
								memset(  pTc->videoConference.pMems_from,  0,  pTc->videoConference.usCntLimit_mems_from  *  sizeof(  TASK_AV_FROM  )  );


								//
								qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg: %s usCntLimit_mems %d, usCntLimit_activeMems %d"   ),  pTask->ucbVideoConferenceStarter  ?  _T(  "Video conference starter:"  )  :  _T(  ""  ),  pTc->videoConference.usCntLimit_mems_from,  pTc->videoConference.usCntLimit_activeMems_from  );

								//  2010/08/31
								memcpy(  &pTc->videoConference.pMems_from[0],  &pTask->mem0_from,  sizeof(  pTc->videoConference.pMems_from[0]  )  );

								//
								if  (  pTask->ucbVideoConferenceStarter  )  {	//  

									//  2009/02/17
									//  memcpy(  &pTask->pMems_from[0],  &pTask->mem0_from,  sizeof(  pTask->pMems_from[0]  )  );
									
									//
									if  (  pTask->videoConferenceCfg.iCols  *  pTask->videoConferenceCfg.iRows  !=  pTc->videoConference.usCntLimit_mems_from  )  goto  errLabel;
									//  if  (  !pTask->videoConferenceCfg.iWidth_pic  ||  !pTask->videoConferenceCfg.iHeight_pic  )  goto  errLabel;
									//pTc->videoConference.usCntLimit_activeMems_from  =  pTask->videoConferenceCfg.usMaxSpeakers;
									if  (  !pTc->videoConference.usCntLimit_activeMems_from  ||  pTc->videoConference.usCntLimit_activeMems_from  >  MAX_conf_activeMems  )  {
										traceLogA(  (char*)  "initMisMsg: usCntLimit_activeMems_from error, %d",  pTc->videoConference.usCntLimit_activeMems_from  );
										goto  errLabel;
									}
									
									//
									//  if  (  makeBmpInfoHeader_rgb(  24,  pTask->videoConferenceCfg.iWidth_pic,  pTask->videoConferenceCfg.iHeight_pic,  &pContent->transferAvInfo.tranInfo.video.vh_decompress.bih  )  )  goto  errLabel;


									//  pBmpInfo_input	=	&pContent->transferAvInfo.tranInfo.video.vh_decompress.bih;

									//  fccHandler  =  fourccStr2i(  pContent->transferAvInfo.tranInfo.video.compressor.fourccStr  );

								}

								//  if  (  pTask->ucbVideoConferenceStarter  )  
								{	//  2011/01/23.

									//
									GENERIC_Q_CFG	qCfg;
									memcpy(  &qCfg,  &pProcInfo->cfg.outputQ_toMix_audio,  sizeof(  qCfg  )  );
									#if  0
										_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pAvTran->audio.uiTranNo_openAvDev  );
										_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pAvTran->audio.uiTranNo_openAvDev  );		
									#endif  
									//  2012/03/24
									_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pMsg->task.iTaskId  );
									_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pMsg->task.iTaskId  );		
																		
									if  (  !(  pTask->mixer.pOutputQ2  =  (  QY_Q2  *  )mymalloc(  sizeof(  QY_Q2  )  )  )  )  goto  errLabel;
									memset(  pTask->mixer.pOutputQ2,  0,  sizeof(  QY_Q2  )  );
									if  (  initQyQ2(  &qCfg,  &pQyMc->cfg.rwLockParam,  1,  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  pTask->mixer.pOutputQ2  )  )  goto  errLabel;

									//  2009/07/26
									memcpy(  &qCfg,  &pProcInfo->cfg.outputQ_toMosaic_video,  sizeof(  qCfg  )  );
									#if  0
										_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pAvTran->video.uiTranNo_openAvDev  );
										_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pAvTran->video.uiTranNo_openAvDev  );		
									#endif
									//  2012/03/24
									_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pMsg->task.iTaskId  );
									_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pMsg->task.iTaskId  );		
																		
									if  (  !(  pTask->photomosaic.pOutputQ2  =  (  QY_Q2  *  )mymalloc(  sizeof(  QY_Q2  )  )  )  )  goto  errLabel;
									memset(  pTask->photomosaic.pOutputQ2,  0,  sizeof(  QY_Q2  )  );
									if  (  initQyQ2(  &qCfg,  &pQyMc->cfg.rwLockParam,  1,  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  pTask->photomosaic.pOutputQ2  )  )  goto  errLabel;

									//
								}		

								//
								pTc->videoConference.uiTranNo_lastModified_pMems_from  =  getuiNextTranNo(  0,  0,  0  );


								//  2009/05/12. init transforms
								switch  (  pContent->transferAvInfo.uiTaskType  )  {
									    case  CONST_imTaskType_transferAvInfo:
										case  CONST_imTaskType_shareDevice_grp:
											  //
											  pTask->usCntLimit_transforms  =  pTc->videoConference.usCntLimit_activeMems_from;											  
											  break;
										case  CONST_imTaskType_viewDynBmp:			//  2009/09/08
											  pTask->usCntLimit_transforms  =  pTc->videoConference.usCntLimit_activeMems_from;
											  break;
										default:
											   break;
								}
								if  (  pTask->doProxy.bExists_avProxy  )  {
									pTask->usCntLimit_transforms  =  1;
								}
								//
								TCHAR  tBuf[128];
								_sntprintf(tBuf, mycountof(tBuf), _T("initMisMsg: usCntLimit_transforms %d"), (int)pTask->usCntLimit_transforms);
								showInfo_open0(0, 0, tBuf);
								//
								if  (  initTransforms(  pProcInfo,  &pMsg->task.addr_logicalPeer,  pMsg->task.iTaskId,  pContent->transferAvInfo.uiTaskType,  &pContent->transferAvInfo.ass.tranInfo,  pTask,  &pMsg->task  )  )  goto  errLabel;
								if  (  startTransformThreads(  pProcInfo,  pContent->transferAvInfo.uiTaskType,  pTask  )  )  goto  errLabel;

								//
								if (pTask->ucbVideoConferenceStarter) {
									int  i;
									time_t  t;
									time(&t);
									//
									if (pProcInfo->av.sizeof_mySaveAvProcInfo) {
										for (i = 0; i < pTask->usCntLimit_transforms; i++)
										{
											QY_TRANSFORM* p = &pTask->pTransforms[i];
											int  size = pProcInfo->av.sizeof_mySaveAvProcInfo;
											p->pSaver = (SAVE_av_procInfo*)mymalloc(size);
											if (!p->pSaver) {
												showInfo_open0(0, 0, _T(""));
												goto  errLabel;
											}
											memset(p->pSaver, 0, size);
											if (initSaver(false, t, pMsg->task.addr_logicalPeer.idInfo.ui64Id,pMsg->task.iTaskId, CONST_saverType_trans, i, (TCHAR*)_T("initMisMsg:"), p->pSaver))  goto  errLabel;
											p->bInited_saver = true;
										}
										for (i = 0; i < pTask->usCntLimit_transforms; i++) {
											QY_TRANSFORM* p = &pTask->pTransforms[i];
											startSaver(p->pSaver);
										}
									}
								}

								//
								if  (  pTask->ucbVideoConferenceStarter  )  {
									//  2011/12/08
									pTask->usCntLimit_dispatchs  =  pTask->usCntLimit_transforms;
								}
								if  (  pTask->doProxy.bExists_avProxy  )  {  //  2014/11/21
									pTask->usCntLimit_dispatchs  =  pTask->usCntLimit_transforms;
								}

								//  2014/11/21
								if  (  pTask->usCntLimit_dispatchs  )  {
									//  2009/06/17				
									if  (  initDispatch_qis(  pProcInfo,  &pMsg->task.addr_logicalPeer,  pMsg->task.iTaskId,  &pContent->transferAvInfo.ass.tranInfo,  pTask  )  )  goto  errLabel;
								}

								//  2009/10/15
								_sntprintf(  pTask->debugHint,  mycountof(  pTask->debugHint  ),  _T(  "avReq: taskId %d, %s"  ),  pMsg->task.iTaskId,  qyGetDesByType1(  getResTable(  0,  &pQyMc->cusRes,  CONST_resId_imTaskTypeTable  ),  pContent->transferAvInfo.uiTaskType  )  );    
								//  traceLogA(  (char*)  "%S",  pTask->debugHint  );

								//  2018/10/30
								if  (  pContent->transferAvInfo.uiTaskType  ==  CONST_imTaskType_transferAvInfo  )  {
									PostMessage(  pTask->hWnd_task,  CONST_qyWm_postComm,  CONST_qyWmParam_misMsgInited,  0  );
								}
								break;
								}
								else {
									   
								
							    AV_TRAN_INFO	*  pAvTran  =	&task->myTask.reply_avTranInfo;//&pContent->transferAvReplyInfo.tranInfo;



								//
								if  (  pTc->videoConference.usCntLimit_mems_from  <  2  ||  pTc->videoConference.usCntLimit_mems_from  >  MAX_mems_taskAv  )  {
									qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg failed, transferAvReply, usCntLimit_mems_from %d, err"  ),  pTc->videoConference.usCntLimit_mems_from  );
									goto  errLabel;
								}

								//  2009/02/16
								pTc->videoConference.pMems_from  =  (  TASK_AV_FROM  *  )mymalloc(  pTc->videoConference.usCntLimit_mems_from  *  sizeof(  TASK_AV_FROM  )  );
								if  (  !pTc->videoConference.pMems_from  )  {
									qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg: malloc for avReplyInfo.pMems_from failed"   )  );
									goto  errLabel;
								}
								memset(  pTc->videoConference.pMems_from,  0,  pTc->videoConference.usCntLimit_mems_from  *  sizeof(  TASK_AV_FROM  )  );

								if  (  pTask->ucbVideoConference  
									||  pTask->receiver.bRecvd_proxiedTranInfo  )  
								{
									//  2009/05/31											
									pTask->audio.pMsgTask_toTransform  =  mymalloc(  sizeof(  MIS_MSG_TASK  )  );
									if  (  !pTask->audio.pMsgTask_toTransform  )  goto  errLabel;
									MACRO_memset_misMsgTask(  pTask->audio.pMsgTask_toTransform  );
								
									pTask->video.pMsgTask_toTransform  =  mymalloc(  sizeof(  MIS_MSG_TASK  )  );
									if  (  !pTask->video.pMsgTask_toTransform  )  goto  errLabel;
									MACRO_memset_misMsgTask(  pTask->video.pMsgTask_toTransform  );
								}

								//  2009/02/17
								//memcpy(  &pTc->videoConference.pMems_from[0],  &pTask->mem0_from,  sizeof(  pTc->videoConference.pMems_from[0]  )  );

								//pTc->videoConference.

								//  2014/11/21
								if  (  pTask->receiver.bRecvd_proxiedTranInfo  )  {
									if  (  pTc->videoConference.usCntLimit_mems_from  <  2  )  goto  errLabel;
									memcpy(  &pTc->videoConference.pMems_from[1],  &pTask->receiver.proxied_from,  sizeof(  pTc->videoConference.pMems_from[1]  )  );
								}


								//  2011/01/26
								//  if  (  pTask->ucbVideoConference  )  
								{	//  2011/01/23.

									//
									GENERIC_Q_CFG	qCfg;
									memcpy(  &qCfg,  &pProcInfo->cfg.outputQ_toMix_audio,  sizeof(  qCfg  )  );
									#if  0
										_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pAvTran->audio.uiTranNo_openAvDev  );
										_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pAvTran->audio.uiTranNo_openAvDev  );		
									#endif
									//  2012/03/24
									_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pMsg->task.iTaskId  );
									_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pMsg->task.iTaskId  );		

																		
									if  (  !(  pTask->mixer.pOutputQ2  =  (  QY_Q2  *  )mymalloc(  sizeof(  QY_Q2  )  )  )  )  goto  errLabel;
									memset(  pTask->mixer.pOutputQ2,  0,  sizeof(  QY_Q2  )  );
									if  (  initQyQ2(  &qCfg,  &pQyMc->cfg.rwLockParam,  1,  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  pTask->mixer.pOutputQ2  )  )  goto  errLabel;

									//  2009/07/26
									memcpy(  &qCfg,  &pProcInfo->cfg.outputQ_toMosaic_video,  sizeof(  qCfg  )  );
									#if  0
										_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pAvTran->video.uiTranNo_openAvDev  );
										_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pAvTran->video.uiTranNo_openAvDev  );		
									#endif
									//  2012/03/24
									_sntprintf(  qCfg.name,  mycountof(  qCfg.name  ),  _T(  "%s%u"  ),  qCfg.name,  pMsg->task.iTaskId  );
									_sntprintf(  qCfg.mutexName_prefix,  mycountof(  qCfg.mutexName_prefix  ),  _T(  "%s%u"  ),  qCfg.mutexName_prefix,  pMsg->task.iTaskId  );		

																		
									if  (  !(  pTask->photomosaic.pOutputQ2  =  (  QY_Q2  *  )mymalloc(  sizeof(  QY_Q2  )  )  )  )  goto  errLabel;
									memset(  pTask->photomosaic.pOutputQ2,  0,  sizeof(  QY_Q2  )  );
									if  (  initQyQ2(  &qCfg,  &pQyMc->cfg.rwLockParam,  1,  NULL,  mallocMemory,  mymalloc,  0,  0,  freeMemory,  myfree,  NULL,  pTask->photomosaic.pOutputQ2  )  )  goto  errLabel;

									//
								}


								//  2009/05/12. init transforms
								switch  (  pContent->transferAvInfo.uiTaskType  )  {
										case  CONST_imTaskType_transferAvInfo:
											  pTask->usCntLimit_transforms  =  pTc->videoConference.usCntLimit_activeMems_from;
											  break;
										default:
												pTask->usCntLimit_transforms  =  1;
												break;
								}
								if  (  initTransforms(  pProcInfo,  &pMsg->task.addr_logicalPeer,  pMsg->task.iTaskId,  pMsg->task.uiTaskType,  &pContent->transferAvReplyInfo.tranInfo,  pTask,  &pMsg->task  )  )  goto  errLabel;
								if  (  startTransformThreads(  pProcInfo,  pMsg->task.uiTaskType,  pTask  )  )  goto  errLabel;

								//  2009/10/15
								_sntprintf(  pTask->debugHint,  mycountof(  pTask->debugHint  ),  _T(  "avReply: taskId %d"  ),  pMsg->task.iTaskId  );    
								//  traceLogA(  (char*)  "%S",  pTask->debugHint  );

								
								break;
								}
								//
								}
							    break;
						  case  CONST_imCommType_transferFileReq: {
							  //
							  if (pTaskInfo->var.pTaskData->uiType != CONST_taskDataType_transferFile)  goto  errLabel;
							  QMC_taskData_transferFile* pTc = (QMC_taskData_transferFile*)pTaskInfo->var.pTaskData;

							  //								
							  TASK_transferFile* task = (TASK_transferFile*)pTaskParam;
							  PROC_TASK_FILE* pTask = &task->myTask;
							  if (!pTask)  goto  errLabel;

							  //
							  int iVal = pContent->transferFileReq.MAX_FILE_SEND_BLOCK_suggest;
							  if (!iVal)  iVal = DEFAULT_MAX_FILE_SEND_BLOCK;
							  //
							  pTask->MAX_FILE_SEND_BLOCK_internal = min(DEFAULT_MAX_FILE_SEND_BLOCK, iVal);

							  //
							  int ii = 0;
						  }
							    break;
						  default:
								 break;
				  }

				  }
				  break;
			default:
					break;
	}

	iErr  =  0;
errLabel:

	if  (  iErr  )  {
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  _T(  "IsClient"  ),  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg failed, to call exitMisMsg"   )  );
		//
		exitMisMsg(  p_msg  );
	}

	qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initMisMsg leaves with %s"   ),  iErr  ?  _T(  "Failed"  )  :  _T(  "OK"  )  );

	traceLogA(  (char*)  "initMisMsg leaves with %s",  iErr  ?  "failed"  :  "OK"  );

	return  iErr;
}

 void  exitMisMsg(  void  *  p_msg  )
{
	TASK_common * pTaskParam=(TASK_common*)p_msg;
	int							index;
	QY_MC					*	pQyMc				=	QY_GET_GBUF(  );
	QY_SERVICEGUI_INFO		*	pSgi				=	(  QY_SERVICEGUI_INFO  *  )getServiceGuiInfo(  pQyMc,  CONST_qyServiceId_is  );
	if  (  !pSgi  )  return;
	MC_VAR_isCli				*	pProcInfo			=	(  MC_VAR_isCli  *  )pSgi->pVar;
	if  (  !pProcInfo  )  return;
	int							i1;

	QMC_TASK_INFO * pTaskInfo=(QMC_TASK_INFO*)getQmcTaskInfoByIndex(pProcInfo,pTaskParam->m_index_taskInfo);
	if(pTaskInfo==NULL)return;

	MIS_MSGU*pMsg=&pTaskInfo->var.pTaskData->msgU;

	#ifdef  __DEBUG__
			traceLogA(  (char*)  "exitMisMsg enters"  );
	#endif
	qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "exitMisMsg enters"   )  );

	//
	if  (  GetCurrentThreadId(  )  !=  pQyMc->gui.ctx_gui_thread.dwThreadId  )  {
		showInfo_open0(  0,  0,  _T(  "exitMisMsg failed, not thread_mgr"  )  );
		#ifdef  __DEBUG__
				MACRO_qyAssert(  0,  _T(  "exitMisMsg failed, not thread_mgr"  )  );
		#endif
	}
	
	//
	switch  (  pMsg->uiType  )  {
			case  CONST_misMsgType_task:  {
				  IM_CONTENTU  *  pContent  =  M_getMsgContent(  pMsg->task.ucFlg,  &pMsg->task.data  );
				  if  (  !pContent  )  goto  errLabel;
				  
				  printMisMsg(  0,  0,  pMsg  );

				  switch  (  pContent->uiType  )  {
						  case  CONST_imCommType_transferFileReq:  {
							    TASK_transferFile * task =( TASK_transferFile*)pTaskParam;

								if  (  task->myTask.fp  )  {
									#ifdef  __DEBUG__
											traceLogA(  (char*)  "exitMisMsg: transferFileReq:{%S}",  pContent->transferFileReq.fullFilePath  );
									#endif
									fclose(  task->myTask.fp  );
								}
								}
								break;
								/*
						  case  CONST_imCommType_transferFileReplyReq:
							    if  (  pContent->transferFileReplyReq.fp  )  {
									#ifdef  __DEBUG__
											traceLogA(  (char*)  "exitMisMsg: transferFileReplyReq:{%S}",  pContent->transferFileReplyReq.fullFilePath_save  );
									#endif
									fclose(  pContent->transferFileReplyReq.fp  );
								}
							    break;
								*/
						  case  CONST_imCommType_transferAvInfo:  {
								//TRANSFER_av_task  *  pTransferAvTask  =  (  TRANSFER_av_task  *  )pContent;
								TASK_transferAv * task=(TASK_transferAv*)pTaskParam;
							    PROC_TASK_AV	*	pTask			=  &task->myTask;						  

							    //PROC_TASK_AV	*	pTask  =  get_transferAvReplyInfo_pTask(  &pContent->transferAvReplyInfo,  _T(  ""  )  );  //  &pContent->transferAvReplyInfo.myTask;
								if  (  !pTask  )  break;

								if  (  pTaskInfo->var.pTaskData->uiType  !=  CONST_taskDataType_conf  )  goto  errLabel;
								QMC_taskData_conf  *  pTc  =  (  QMC_taskData_conf *  )pTaskInfo->var.pTaskData;

							  //
							  if(!pTaskInfo->var.m_bReplyTask ) {
							    if  (  pContent->transferAvInfo.tmp_usSubtype  !=  CONST_transferAvInfo_subtype_task  )  {
									#ifdef  __DEBUG__
											MACRO_qyAssert(  0,  _T(  "transferAvInfo.subtype err, not task"  )  );
									#endif
									break;
								}
								
								//  2008/11/20¡£°´Àí£¬Ö»ÓÐÔ¶³ÌÐ­Öú²Å¿ÉÒÔÇåÀí¡£µ«ÊÇËÆºõÒ²Ã»ÓÐÊ²Ã´Ó°Ïì¡£
								clearShiftKeys(  );

								//  2010/09/05
								QY_SHARED_OBJ	*	pSharedObj		=	NULL;
								if  (  (  pSharedObj  =  getSharedObjByIndex(  pProcInfo,  pTask->iIndex_sharedObj  )  )  )  {
									#if  0
										removeFromMsgrs_sendLocalAv(  pProcInfo,  (  MIS_CNT  *  )pMsg->task.pMisCnt,  &pMsg->task.idInfo_taskReceiver,  pSharedObj  );
									#endif
								}

								//  2009/06/17
								exitDispatch_qis(  pTask  );

								//
				 //
								stopTransformThreads(pProcInfo, pTask);

								//
								int  i;
								//
								for (i = 0; i < pTask->usCntLimit_transforms; i++) {
									QY_TRANSFORM* pTransform = &pTask->pTransforms[i];
									if (pTransform->bInited_saver) {
										if (pTransform->pSaver) {
											pTransform->pSaver->bQuit = true;
										}
									}
								}
								//
								for (i = 0; i < pTask->usCntLimit_transforms; i++) {
									QY_TRANSFORM* pTransform = &pTask->pTransforms[i];
									if (pTransform->bInited_saver) {
										stopSaver(pTransform->pSaver);
										exitSaver(pTransform->pSaver);
									}
									MACRO_safeFree(pTransform->pSaver);
								}

								//  2009/05/12
								exitTransforms(  pProcInfo,  pTask  );

								//
							    for  (  index  =  0;  index  <  pTc->videoConference.usCntLimit_mems_from;  index  ++  )  {
									 //  exitTaskAvFrom_video(  pProcInfo,  &pContent->transferAvInfo.myTask.pMems_from[index]  );
									 //  exitTaskAvFrom_audio(  pProcInfo,  &pContent->transferAvInfo.myTask.pMems_from[index]  );
								}

								//  if  (  pTask->mixer.pMsgTask_toCompress  )  free(  pTask->mixer.pMsgTask_toCompress  );

								//  if  (  pTask->mixer.pOutputQ  )  genericQFree(  pTask->mixer.pOutputQ  );
								if  (  pTask->mixer.pOutputQ2  )  {
									exitQyQ2(  pTask->mixer.pOutputQ2  );
									MACRO_safeFree(  pTask->mixer.pOutputQ2  );
								}
								if  (  pTask->photomosaic.pOutputQ2  )  {		//  2009/07/26
									exitQyQ2(  pTask->photomosaic.pOutputQ2  );
									MACRO_safeFree(  pTask->photomosaic.pOutputQ2  );
								}

								//  2008/10/06
								if  (  !pTask->doProxy.bExists_avProxy  )  {		//  2014/11/20
									if  (  pContent->transferAvInfo.uiTaskType  !=  CONST_imTaskType_transferAvInfo  )  {	//  
										askSharedObjToStop(  pProcInfo,  pSharedObj,  pQyMc->gui.hMainWnd,  _T(  "exitMisMsg avInfo"  )  );
									}
								}

								//  2009/05/31
								MACRO_safeFree(  pTask->audio.pMsgTask_toTransform  );
								MACRO_safeFree(  pTask->video.pMsgTask_toTransform  );

								//  2009/02/16
								if  (  pTc->videoConference.pMems_from  )  {
									free(  pTc->videoConference.pMems_from  );  pTc->videoConference.pMems_from  =  NULL;
								}

								break;
								
							  }
																  
								else {
									 int ii=0;
								
																  
								
								//  2008/11/20¡£°´Àí£¬Ö»ÓÐÔ¶³ÌÐ­Öú²Å¿ÉÒÔÇåÀí¡£µ«ÊÇËÆºõÒ²Ã»ÓÐÊ²Ã´Ó°Ïì¡£
								clearShiftKeys(  );

								//  2010/09/05
							#if  0
								QY_SHARED_OBJ	*	pSharedObj	=	NULL;
								if  (  (  pSharedObj  =  getSharedObjByIndex(  pProcInfo,  pTask->iIndex_sharedObj  )  )  )  {
                                    removeFromMsgrs_sendLocalAv(  pProcInfo,  (  MIS_CNT  *  )pMsg->task.pMisCnt,  &pMsg->task.idInfo_taskSender,  pSharedObj  );
								}
							#endif
								
								//  2009/05/12
								exitTransforms(  pProcInfo,  pTask  );
								
								//
							    for  (  index  =  0;  index  <  pTc->videoConference.usCntLimit_mems_from;  index  ++  )  {
									 //  exitTaskAvFrom_video(  pProcInfo,  &pContent->transferAvReplyInfo.myTask.pMems_from[index]  );									 
									 //  exitTaskAvFrom_audio(  pProcInfo,  &pContent->transferAvReplyInfo.myTask.pMems_from[index]  );									 
								}
								
								//
								if  (  pTask->mixer.pOutputQ2  )  {
									exitQyQ2(  pTask->mixer.pOutputQ2  );
									MACRO_safeFree(  pTask->mixer.pOutputQ2  );
								}
								if  (  pTask->photomosaic.pOutputQ2  )  {		//  2009/07/26
									exitQyQ2(  pTask->photomosaic.pOutputQ2  );
									MACRO_safeFree(  pTask->photomosaic.pOutputQ2  );
								}

								//  2009/05/31
								MACRO_safeFree(  pTask->audio.pMsgTask_toTransform  );
								MACRO_safeFree(  pTask->video.pMsgTask_toTransform  );
								//  2009/02/16
								if  (  pTc->videoConference.pMems_from  )  {
									free(  pTc->videoConference.pMems_from  );  pTc->videoConference.pMems_from  =  NULL;
								}
								//
								break;
							  }
								}
								//
							    break;
						  default:
								  break;
				  }				  

				  }
				  break;
			default:
					break;
	}		

errLabel:

	#ifdef  __DEBUG__
			traceLogA(  (char*)  "exitMisMsg leaves"  );
	#endif
	qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "exitMisMsg leaves"   )  );


	return;
}





 //  
