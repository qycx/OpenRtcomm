			if  (  !pFrom->audio.ta_recvd.ah_decompress.wfx.nChannels  ||  !pFrom->audio.ta_recvd.ah_decompress.wfx.nSamplesPerSec  ||  !pFrom->audio.ta_recvd.ah_decompress.wfx.wBitsPerSample  )  {
