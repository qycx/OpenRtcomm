			  compressor.common.pf_parseDecAPkt_o  =  parseDecAPkt_o;


			  compressor.common.pf_detachPkt  =  detachAPkt;
			  compressor.common.pf_clean_myPLAY_AUDIO_DATA  =  (  PF_clean_myPLAY_AUDIO_DATA  )clean_myPLAY_AUDIO_DATA;


			  //  2014/09/07
			  compressor.common.iDecParam_index_pMems_from  =  index_pMems_from;
			  //  2014/07/09
			  compressor.common.dec.pf_smplBitstreamReader_ReadNextFrame_func  =  smplBitstreamReader_ReadNextFrame_func_a;



			  //  2015/01/17
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame_pre  =  smplPCMWriter_WriteNextFrame_pre;	//  2015/01/17
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame0  =  smplPCMWriter_WriteNextFrame0;			//  2014/07/23
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame1  =  smplPCMWriter_WriteNextFrame1;			//  2014/07/23
			  //
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame_all  =  smplPCMWriter_WriteNextFrame_all;		//  2014/07/23
			  
			  
			  //
			  //compressor.common.dec.pf_updateDecVideoParam  =  updateDecVideoParam;
			  //
			  compressor.common.dec.pf_postAPktToRender  =  (  PF_commonHandler  )postAPktToRender;
			  
#if  0		

			  //  2014/03/29
			  compressor.common.ucHardwareAccl  =  pQmcCfg->policy.ucHardwareAccl;
			  //  2015/10/04
			  compressor.common.usPktResType_suggested  =  real_usPktResType;	//  2016/04/28	//  pProcInfo->get_pktResType_suggested(  CONST_pktUsage_dec  );
			  //  2014/07/17
			  pTransformVideo->u.qoi.myQoi.common.var.pDebugStep  =  &pTransform->video.debugStep;



#endif
			  /////////////////////////

			  //  2016/12/25
			  pTransformAudio->u.qoi.myQoi.common.uiType  =  CONST_qoiType_decA;
			  //  2016/12/25				
			  pProcInfo->set_qoi_funcs(  &pTransformAudio->u.qoi.myQoi  );

			  //
			  if  (  pModule->compress.pf_qdcInitDecompressAudio(  &compressor,  &pTransform->audio.ta.ah_compress,  &pTransform->audio.ta.ah_decompress,  &pTransform->audio.u.qoi.myQoi.common  )  )  {
					  traceLogA(  (char*)  "initTaskAvFrom_video: initDmoDecompressVideo failed."  );
					  goto  errLabel;
			  }
		}
		//
		//  if  (  !(  pTransferAudioData  =  (  TRANSFER_AUDIO_DATA  *  )mymalloc(  sizeof(  TRANSFER_AUDIO_DATA  )  )  )  )  goto  errLabel;
		//  memset(  pTransferAudioData,  0,  sizeof(  TRANSFER_AUDIO_DATA  )  );
		
		//  pFrom->audio.pDecompressBuf_transferAudioData  =  pTransferAudioData;	pTransferAudioData  =  NULL;
		
		//  2015/05/19
		if  (  pTask->saveVideo.ucbSaveVideo_req  )  {
			pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  =  sizeof(  SAVE_audio_pkt  );
			if  (  pTransformAudio->saveAudio.pSaveAudioPkt  )  {
				qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio failed: pSaveAudioPkt is not null."  )  );
				goto  errLabel;
			}
			pTransformAudio->saveAudio.pSaveAudioPkt  =  mymalloc(  pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  );
			if  (  !pTransformAudio->saveAudio.pSaveAudioPkt  )  goto  errLabel;
			memset(  pTransformAudio->saveAudio.pSaveAudioPkt,  0,  pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  );
		}


		//
		pTransform->audio.index_pMems_from  =  index_pMems_from;

		pTransform->audio.ucbInited  =  TRUE;
	}


	iErr  =  0;

errLabel:

	if  (  hstr1  )  {
		acmStreamClose(  hstr1,  0  );	hstr1	=	NULL;
	}
	if  (  hstr2  )  {
		acmStreamClose(  hstr2,  0  );	hstr2	=	NULL;
	}	

	if  (  pWf_compress  )  free(  pWf_compress  );
	if  (  pWf_pcm  )  free(  pWf_pcm  );
	if  (  pWf_decompress  )  free(  pWf_decompress  );
	
	//  if  (  pTransferAudioData  )  free(  pTransferAudioData  );

	if  (  iErr  )  {	//  2012/03/20
		exitTaskAvFrom_audio(  pProcInfo,  pTransform  );
	}

	//  if  (  iErr  ||  tHintBuf[0]  )  
	{
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio %d: %I64u %s: %s"  ),  pTransform->index_activeMems_from,  pFrom->idInfo.ui64Id,  (  iErr  ?  _T(  "failed"  )  :  _T(  ""  )  ),  tHintBuf  );
	}

	traceLogA(  (char*)  "initTaskAvFrom_audio: %I64u leaves",  pFrom->idInfo.ui64Id  );

	return  iErr;
}
#endif


//
int  initTaskAvFrom_audio(  MC_VAR_common  *  pProcInfo,  DLG_TALK_videoConferenceActiveMemFrom  *  pActiveMem_from,  int  index_activeMems_from,  QY_TRANSFORM  *  pTransform  )
{
	int							iErr				=	-1;
	TCHAR						tHintBuf[256]		=	_T(  ""  );
	int							tmpiRet				=	-1;
	int							i;

	QY_MC					*	pQyMc				=   (  QY_MC  *  )pProcInfo->pQyMc;//QY_GET_GBUF(  );
	if  (  !pQyMc  )  return  -1;
	QMC_cfg					*	pQmcCfg				=	(  QMC_cfg  *  )pProcInfo->get_qmc_cfg(  );
	if  (  !pQmcCfg  )  return  -1;

	//
	PROC_TASK_AV				*	pTask		=	(  PROC_TASK_AV  *  )pTransform->pTask;
	if  (  !pTask  )  {  //  2014/08/04
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio failed: pTask is null."  )  );
		return  -1;
	}
	TRANSFORM_AUDIO_procInfo  *  pTransformAudio  =  &pTransform->audio;
	

	//
	WAVEFORMATEX			*	pWf_compress		=	NULL;
	WAVEFORMATEX			*	pWf_pcm				=	NULL;
	WAVEFORMATEX			*	pWf_decompress		=	NULL;

	MMRESULT					mmr;
	HACMDRIVER					had					=	NULL;
	HACMSTREAM					hstr1				=	NULL;
	HACMSTREAM					hstr2				=	NULL;

	TCHAR						tBuf[128];
	
	//
	#ifdef  __DEBUG__
			traceLogA(  (char*)  "initTaskAvFrom_audio: %I64u enters",  pActiveMem_from->avStream.idInfo.ui64Id  );
	#endif
	
	//
	if  (  pTransform->audio.ucbInited  )  {	//  2009/05/29
		traceLogA(  (char*)  "initTaskAvFrom_audio failed: already inited."  );
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ), 
			_T(  "initTaskAvFrom_audio failed: already inited."  )  );
		goto  errLabel;
	}

	if  (  !pTransform->audio.ucbInited  )  {		
		if  (  !pActiveMem_from->avStream.obj.tranInfo.audio.uiTranNo_openAvDev  )  {
			qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),
				_T(  "initTaskAvFrom_audio failed: uiTranNo_openAvDev is 0, audio data can't be accepted."  )  );
			goto  errLabel;
		}

		try  {
		//  2009/05/28
		{
			CQySyncObj	syncObj;
			TCHAR	mutexName[128];
			//  2011/07/03
			//  _sntprintf(  mutexName,  mycountof(  mutexName  ),  _T(  "%s%d"  ),  pProcInfo->cfg.mutexName_syncActiveMem_prefix,  pTransform->iTaskId  );
			M_getMutexName_syncActiveMem(  pQmcCfg,  pTransform->iTaskId,  mutexName,  mycountof(  mutexName  )  );
			if  (  syncObj.sync(  mutexName,  1000   )  )  goto  errLabel;

			pTransform->audio.idInfo.ui64Id  =  pActiveMem_from->avStream.idInfo.ui64Id;
#if  0  //2016/12/23
			pTransform->audio.ta.uiTranNo_openAvDev  =  pFrom->audio.ta_recvd.uiTranNo_openAvDev;
		    #if  0  //  2011/12/24
				pTransform->audio.ucCompressors  =  pFrom->audio.compressor.ucCompressors;
			#else
				memcpy(  &pTransform->audio.ta.compressor,  &pFrom->audio.ta_recvd.compressor,  sizeof(  pTransform->audio.ta.compressor  )  );
			#endif
			memcpy(  &pTransform->audio.ta.ah_compress,  &pFrom->audio.ta_recvd.ah_compress,  sizeof(  pTransform->audio.ta.ah_compress  )  );
			memcpy(  &pTransform->audio.ta.ah_decompress,  &pFrom->audio.ta_recvd.ah_decompress,  sizeof(  pTransform->audio.ta.ah_decompress  )  );
#endif
			//  2016/12/23
			pTransform->audio.ta  =  pActiveMem_from->avStream.obj.tranInfo.audio;

			//
	#ifdef  __DEBUG__
		#if  10
			  AH_stream  *  pAh_stream  =  &pTransform->audio.ta.ah_stream;
			  int  iii;

			  for  (  iii  =  0;  iii  <  58;  iii  ++  )  {
				   TCHAR  tt[128];
				   _sntprintf(  tt,  mycountof(  tt  ),  _T(  "header[%d] %02x\n"  ),  iii,  (  unsigned  char  )pAh_stream->buf[iii]  );
				   //OutputDebugString(  tt  );
			  }
			  iii  =  iii;
		#endif
	#endif

		}
		}
#ifdef  __useMfc__
		catch  (  CException  *  e  )  {
			e->Delete(  );
			goto  errLabel;
		}
#endif
		catch  (  ...  )  {
			goto  errLabel;
		}

		//  2015/09/11
		memset(  &pTransform->audio.debugStep,  0,  sizeof(  pTransform->audio.debugStep  )  );
		memset(  &pTransform->audio.status,  0,  sizeof(  pTransform->audio.status  )  );
		memset(  &pTransform->audio.decInfo,  0,  sizeof(  pTransform->audio.decInfo  )  );

		//
		MACRO_setMyStep(  pTransform->audio.debugStep,  33  );

		//
		if  (  !pActiveMem_from->avStream.obj.tranInfo.audio.compressor.common.ucCompressors  )  pTransform->audio.ta.compressor.common.ucCompressors  =  CONST_audioCompressors_acm;		//  2009/03/30

		//  2014/03/25
		memset(  &pTransform->audio.u,  0,  sizeof(  pTransform->audio.u  )  );

		//
		if  (  pTransform->audio.ta.compressor.common.ucCompressors  ==  CONST_audioCompressors_acm  )  {

#ifdef  __SUPPORT_acmToDec__
		HACMDRIVERID	hadid	=	NULL;

	#ifndef  __WINCE__
			hadid  =  find_driver(  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wFormatTag,  
				pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nChannels, 
				pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nSamplesPerSec, 
				pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wBitsPerSample  );
			if  (  hadid  ==  NULL  )  {
				#ifdef  __DEBUG__
						traceLogA(  (char*)  "initTaskAvFrom_audio failed. No driver found."  );
				#endif
				//
				_sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "initTaskAvFrom_audio failed. No driver found. wFormagTag %d"  ),  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wFormatTag  );
				showInfo_open0(  0,  0,  tBuf  );
				//
				goto  errLabel;
			}
			#ifdef  __DEBUG__
					traceLogA(  (char*)  "Driver found ( hadid: %4.4lxh)\n",  hadid  );
			#endif
		
			//  ÕÒµ½¸ø¶¨±êÇ©µÄ¶ÔÓ¦µÄ¸ñÊ½
			pWf_compress	=	get_driver_format(  hadid,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wFormatTag,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nChannels,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nSamplesPerSec,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wBitsPerSample  );
			if  (  !pWf_compress  )  goto  errLabel;
			#ifdef  __DEBUG__
					traceLogA(  (char*)  "Driver format:%u bits,  %lu samples ps, %d channels\n ",  pWf_compress->wBitsPerSample,  pWf_compress->nSamplesPerSec,  pWf_compress->nChannels  );
			#endif

			//  ÕÒµ½¸ø¶¨±êÇ©¶ÔÓ¦µÄÇý¶¯
			pWf_pcm	=	get_driver_suggestedFormat(  hadid,	pWf_compress,  WAVE_FORMAT_PCM,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nChannels,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.nSamplesPerSec,  pActiveMem_from->avStream.obj.tranInfo.audio.ah_compress.wfx.wBitsPerSample  );
			if  (  !pWf_pcm	)  goto  errLabel;
			#ifdef  __DEBUG__
					traceLogA(  (char*)  "PCM  format: %u bits,  %lu samples ps, %d channels\n",  pWf_pcm->wBitsPerSample,  pWf_pcm->nSamplesPerSec,  pWf_pcm->nChannels  );
			#endif

			//
			pWf_decompress  =  (  WAVEFORMATEX  *  )mymalloc(  sizeof(  WAVEFORMATEX  )  );
			if  (  !pWf_decompress  )  goto  errLabel;
			if  (  !pActiveMem_from->avStream.obj.tranInfo.audio.ah_decompress.wfx.nChannels  ||  !pActiveMem_from->avStream.obj.tranInfo.audio.ah_decompress.wfx.nSamplesPerSec  ||  !pActiveMem_from->avStream.obj.tranInfo.audio.ah_decompress.wfx.wBitsPerSample  )  {
				qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio: wave fomat error, use default."  )  );
				makeWaveFormat_pcm(  DEFAULT_nChannels_pcm_av_old,  DEFAULT_iHertz_pcm_av_old,  DEFAULT_wBitsPerSample_pcm_av_old,  &pTransform->audio.ta.ah_decompress.wfx  );
			}
			memcpy(  pWf_decompress,  &pActiveMem_from->avStream.obj.tranInfo.audio.ah_decompress.wfx,  sizeof(  WAVEFORMATEX  )  );
	#else
			switch  (  pFrom->audio.ah_compress_recvd.wfx.wFormatTag  )  {
					case  WAVE_FORMAT_GSM610:
						  GSM610WAVEFORMAT  *  pGsm610;  pGsm610  =  (  GSM610WAVEFORMAT  *  )&pFrom->audio.ah_compress_recvd.wfx;
						  pWf_compress  =  (  WAVEFORMATEX  *  )mymalloc(  sizeof(  pFrom->audio.ah_compress_recvd.wfx  )  +  pFrom->audio.ah_compress_recvd.wfx.cbSize  );
						  if  (  !pWf_compress  )  goto  errLabel;
						  memcpy(  pWf_compress,  &pFrom->audio.ah_compress_recvd.wfx,  sizeof(  pFrom->audio.ah_compress_recvd.wfx  )  +  pFrom->audio.ah_compress_recvd.wfx.cbSize  );
						  pWf_pcm  =  (  WAVEFORMATEX  *  )mymalloc(  sizeof(  WAVEFORMATEX  )  );
						  if  (  !pWf_pcm  )  goto  errLabel;
						  makeWaveFormat_pcm(  1,  8000,  16,  pWf_pcm  );
						  pWf_decompress  =  (  WAVEFORMATEX  *  )mymalloc(  sizeof(  WAVEFORMATEX  )  );
						  if  (  !pWf_decompress  )  goto  errLabel;
						  memcpy(  pWf_decompress,  &pFrom->audio.ah_decompress_recvd.wfx,  sizeof(  WAVEFORMATEX  )  );
						  break;
					default:
						    traceLog((TCHAR*)  _T(  "initTaskAvFrom_audio failed: wFormatTag not supported"  )  );
							goto  errLabel;
			}
	#endif

			if  (  !pWf_compress->nAvgBytesPerSec  )  goto  errLabel;
			if  (  !pWf_pcm->nAvgBytesPerSec  )  goto  errLabel;
			if  (  pWf_decompress->wFormatTag  !=  WAVE_FORMAT_PCM  )  goto  errLabel;
			if  (  !pWf_decompress->nAvgBytesPerSec  )  goto  errLabel;

			try  {
				 mmr	=  acmStreamOpen(  &hstr1,  had,  pWf_compress,  pWf_pcm,  NULL,  NULL,  0,  ACM_STREAMOPENF_NONREALTIME  );
				}
#ifdef  __useMfc__
			catch  (  CException  *  e  )  {
				   e->Delete(  );
				   mmr  =  -1;
			}
#endif
			catch  (  ...  )  {
				   mmr  =  -1;
			}
			if  (  mmr  )  {
				hstr1  =  NULL;  goto  errLabel;
			}			
			try  {
				 mmr	=  acmStreamOpen(  &hstr2,  had,  pWf_pcm,  pWf_decompress,  NULL,  NULL,  0,  ACM_STREAMOPENF_NONREALTIME  );
				}
#ifdef  __useMfc__
			catch  (  CException  *  e  )  {
				   e->Delete(  );
				   mmr  =  -1;
			}
#endif
			catch  (  ...  )  {
				   mmr  =  -1;
			}
			if  (  mmr  )  {
				hstr2  =  NULL;  goto  errLabel;
			}

			//
			pTransform->audio.u.acm.hadid  =  hadid;
			pTransform->audio.u.acm.hstr1  =  hstr1;  hstr1  =  NULL;
			pTransform->audio.u.acm.hstr2  =  hstr2;  hstr2  =  NULL;
			pTransform->audio.pWf_compress  =  pWf_compress;	pWf_compress  =  NULL;		
			pTransform->audio.pWf_pcm  =  pWf_pcm;  pWf_pcm  =  NULL;
			pTransform->audio.pWf_decompress  =  pWf_decompress;  pWf_decompress  =  NULL;
#else
			if  (  initDecompressAudio_filterGraph(  &pFrom->audio.compressor,  &pTransform->audio.ah_compress,  &pTransform->audio.ah_decompress,  &pTransform->audio.u.dmo  )  )  {
				traceLogA(  (char*)  "initTaskAvFrom_audio: initDecompressAudio failed."  );
				goto  errLabel;
			}
#endif
			}
		else  if  (  pTransform->audio.ta.compressor.common.ucCompressors  ==  CONST_audioCompressors_dmo  )  {		
#if  0
			      pTransform->audio.u.dmo.usCnt  =  pFrom->ucbVideoConferenceStarter  ?  mycountof(  pTransform->audio.u.dmo.dmoInfos  )  :  1;
				  
				  for  (  i  =  0;  i  <  pTransform->audio.u.dmo.usCnt;  i  ++  )  {
					   if  (  initDecompressAudio_dmo(  &pFrom->audio.compressor,  &pTransform->audio.ah_compress,  &pTransform->audio.ah_decompress,  &pTransform->audio.u.dmo.dmoInfos[i]  )  )  {
					  	   traceLogA(  (char*)  "initTaskAvFrom_video: initDmoDecompressVideo failed."  );
					  	   goto  errLabel;
					   }
				  }
#endif

				  if  (  initDecompressAudio_dmo(  pProcInfo->pQyMc,  &pActiveMem_from->avStream.obj.tranInfo.audio.compressor,  &pTransform->audio.ta.ah_compress,  &pTransform->audio.ta.ah_decompress,  &pTransform->audio.u.dmo  )  )  {
					  traceLogA(  (char*)  "initTaskAvFrom_video: initDmoDecompressVideo failed."  );
					  goto  errLabel;
				  }

				  }
		else  {
			  CUS_MODULE_U	*	pModule  =  NULL;
			  unsigned  int		uiModuleType	=	0;				//  2012/09/09


			  switch  (  pTransform->audio.ta.compressor.common.ucCompressors  )  {
				      case  CONST_audioCompressors_ipp:
						    //pModule  =  pQyMc->cusModules.pIpp;
						    uiModuleType  =  CONST_moduleType_ipp;	//  2014/09/01
						    break;
					  case  CONST_audioCompressors_ffmpeg:
						    //uiModuleType=CONST_moduleType_ipp;
							uiModuleType=CONST_moduleType_ffmpeg;
							break;
					  case  CONST_audioCompressors_lyra:
						    uiModuleType = CONST_moduleType_lyra;
							break;
					  case  CONST_audioCompressors_vorbis:
						    uiModuleType  =  CONST_moduleType_qdc_vorbis_dec;	//  2016/12/05
						    break;
					  case  CONST_audioCompressors_custom:
						    // pModule  =  getCusModule(  pProcInfo->pQyMc,  CONST_moduleType_compress  );								
						    uiModuleType  =  CONST_moduleType_compress;
							break;
					  case CONST_audioCompressors_aac:
						  uiModuleType = CONST_moduleType_aac;
						  break;
					  default:
						  traceLogA(  (char*)  "initTaskAvFrom_audio: ucCompressors %d, error",  pTransform->audio.ta.compressor.common.ucCompressors  );
							 goto  errLabel;
							 break;
			  }
			  //
			  M_getCompressModule(  &pQyMc->cusModules,  uiModuleType,  pModule  );	//  2012/09/09
			  if  (  !pModule  ||  !pModule->compress.pf_qdcInitDecompressAudio  )  {

				  _sntprintf(  tHintBuf,  mycountof(  tHintBuf  ),  _T(  "%s pModule or initDecA is null. moduleType %d"  ),  tHintBuf,  uiModuleType  );
#if  10
				  //
				  TCHAR  tBuf[128];
				  _sntprintf(  tBuf,  mycountof(  tBuf  ),  _T(  "decA: wFormatTag: 0x%x not supported"  ),  (  int  )pTransform->audio.ta.ah_compress.wfx.wFormatTag  );
				  showNotification(  0,  0,  0,  0,  0,  0,  tBuf  );
#endif

				  goto  errLabel;
			  }
			  //  2016/12/05
			  pTransform->audio.uiModuleType_toDec  =  uiModuleType;

			  ///////////////////////////
			  //  2016/12/10
			  //  2014/03/25
			  AUDIO_COMPRESSOR_CFG  compressor;
			  memcpy(  &compressor,  &pActiveMem_from->avStream.obj.tranInfo.audio.compressor,  sizeof(  compressor  )  );

			  compressor.common.pCurPkt  =  pTransformAudio->pCurPkt;

			  compressor.common.size_pCurPkt  =  sizeof(  pTransformAudio->pCurPkt[0]  );
			  //
			  //compressor.common.pInDataCacheQ  =  pTransformAudio->pInDataCacheQ;
			  //
			  compressor.common.pAudioQ2  =  &pTransformAudio->q2;
			  //
			  //compressor.common.pTmpDataQ  =  pTransformAudio->pTmpDataQ;
			  //
			  compressor.common.pParent_transform  =  pTransform;
			  compressor.common.uiTransformType_pParent  =  CONST_uiTransformType_dec;
			  
			  //
			  compressor.common.pf_bTransformAudioQuit  =  bTransformAudioQuit;
			  //compressor.common.pf_transformGetSpsPps  =  transformGetSpsPps;
			  compressor.common.pf_transformGetWfx  =  (  PF_commonHandler  )transformGetWfx;
			  compressor.common.pf_getNextAPkt  =  (  PF_commonHandler  )getNextAPkt;


			  //compressor.common.pf_parseVPkt_i  =  dec_parseEncVPkt_i;
			  compressor.common.pf_parseDecAPkt_o  =  parseDecAPkt_o;


			  compressor.common.pf_detachPkt  =  detachAPkt;
			  compressor.common.pf_clean_myPLAY_AUDIO_DATA  =  (  PF_clean_myPLAY_AUDIO_DATA  )clean_myPLAY_AUDIO_DATA;


			  //  2014/09/07
			  compressor.common.iDecParam_index_pMems_from  =  index_activeMems_from;
			  //  2014/07/09
			  compressor.common.dec.pf_smplBitstreamReader_ReadNextFrame_func  =  smplBitstreamReader_ReadNextFrame_func_a;



			  //  2015/01/17
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame_pre  =  smplPCMWriter_WriteNextFrame_pre;	//  2015/01/17
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame0  =  smplPCMWriter_WriteNextFrame0;			//  2014/07/23
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame1  =  smplPCMWriter_WriteNextFrame1;			//  2014/07/23
			  //
			  compressor.common.dec.pf_smplPCMWriter_WriteNextFrame_all  =  smplPCMWriter_WriteNextFrame_all;		//  2014/07/23
			  
			  
			  //
			  //compressor.common.dec.pf_updateDecVideoParam  =  updateDecVideoParam;
			  //
			  compressor.common.dec.pf_postAPktToRender  =  (  PF_commonHandler  )postAPktToRender;

			  
			  if (pTransform->audio.ta.compressor.common.ucCompressors == CONST_audioCompressors_aac) {
				  compressor.common.iAvgBitrateInKbps = pTransform->audio.ta.compressor.common.iAvgBitrateInKbps;
			  }
			  
#if  0		

			  //  2014/03/29
			  compressor.common.ucHardwareAccl  =  pQmcCfg->policy.ucHardwareAccl;
			  //  2015/10/04
			  compressor.common.usPktResType_suggested  =  real_usPktResType;	//  2016/04/28	//  pProcInfo->get_pktResType_suggested(  CONST_pktUsage_dec  );
			  //  2014/07/17
			  pTransformVideo->u.qoi.myQoi.common.var.pDebugStep  =  &pTransform->video.debugStep;



#endif
			  /////////////////////////

			  //  2016/12/25
			  pTransformAudio->u.qoi.myQoi.common.uiType  =  CONST_qoiType_decA;
			  //  2016/12/25				
			  pProcInfo->set_qoi_funcs(  &pTransformAudio->u.qoi.myQoi  );

			  //
			  if  (  pModule->compress.pf_qdcInitDecompressAudio(  &compressor,  &pTransform->audio.ta.ah_compress,  &pTransform->audio.ta.ah_decompress,  &pTransform->audio.u.qoi.myQoi.common  )  )  {
					  traceLogA(  (char*)  "initTaskAvFrom_video: initDmoDecompressVideo failed."  );
					  goto  errLabel;
			  }
		}
		//
		//  if  (  !(  pTransferAudioData  =  (  TRANSFER_AUDIO_DATA  *  )mymalloc(  sizeof(  TRANSFER_AUDIO_DATA  )  )  )  )  goto  errLabel;
		//  memset(  pTransferAudioData,  0,  sizeof(  TRANSFER_AUDIO_DATA  )  );
		
		//  pFrom->audio.pDecompressBuf_transferAudioData  =  pTransferAudioData;	pTransferAudioData  =  NULL;
		
		//  2015/05/19
		if  (  pTask->saveVideo.ucbSaveVideo_req  )  {
			pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  =  sizeof(  SAVE_audio_pkt  );
			if  (  pTransformAudio->saveAudio.pSaveAudioPkt  )  {
				qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio failed: pSaveAudioPkt is not null."  )  );
				goto  errLabel;
			}
			pTransformAudio->saveAudio.pSaveAudioPkt  =  mymalloc(  pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  );
			if  (  !pTransformAudio->saveAudio.pSaveAudioPkt  )  goto  errLabel;
			memset(  pTransformAudio->saveAudio.pSaveAudioPkt,  0,  pTransformAudio->saveAudio.uiSize_pSaveAudioPkt  );
		}


		//
		pTransform->audio.index_activeMems_from  =  index_activeMems_from;

		pTransform->audio.ucbInited  =  TRUE;
	}


	iErr  =  0;

errLabel:

	if  (  hstr1  )  {
		acmStreamClose(  hstr1,  0  );	hstr1	=	NULL;
	}
	if  (  hstr2  )  {
		acmStreamClose(  hstr2,  0  );	hstr2	=	NULL;
	}	

	if  (  pWf_compress  )  free(  pWf_compress  );
	if  (  pWf_pcm  )  free(  pWf_pcm  );
	if  (  pWf_decompress  )  free(  pWf_decompress  );
	
	//  if  (  pTransferAudioData  )  free(  pTransferAudioData  );

	if  (  iErr  )  {	//  2012/03/20
		exitTaskAvFrom_audio(  pProcInfo,  pTransform  );
	}

	//  if  (  iErr  ||  tHintBuf[0]  )  
	{
		qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "initTaskAvFrom_audio %d: %I64u %s: %s"  ),  pTransform->index_activeMems_from,  pActiveMem_from->avStream.idInfo.ui64Id,  (  iErr  ?  _T(  "failed"  )  :  _T(  ""  )  ),  tHintBuf  );
	}

	traceLogA(  (char*)  "initTaskAvFrom_audio: %I64u leaves",  pActiveMem_from->avStream.idInfo.ui64Id  );

	return  iErr;
}



 


 //  void  exitTaskAvFrom_audio(  MC_VAR_isCli  *  pProcInfo,  TASK_AV_FROM  *  pFrom  )
 void  exitTaskAvFrom_audio(  MC_VAR_common  *  pProcInfo,  QY_TRANSFORM  *  pTransform  )
{
	QY_MC	*	pQyMc	=	QY_GET_GBUF(  );
	//  if  (  !pFrom  ||  !pFrom->idInfo.ui64Id  )  return;
	int		i;
	
	CUS_MODULES  *  pCusModules  =  (  CUS_MODULES  *  )pProcInfo->getCusModules(  );
	if  (  !pCusModules  )  {
		MACRO_qyAssert(  0,  _T(  "exitTaskAvFrom_video: pCusModules is null"  )  );
		return;
	}

	//  traceLogA(  (char*)  "exitTaskAvFrom_audio: %I64u enters",  pFrom->idInfo.ui64Id  );

	//  if  (  pFrom->audio.ucbInited  )  
	{
		if  (  !pTransform->audio.ta.compressor.common.ucCompressors  )  ;
		else  if  (  pTransform->audio.ta.compressor.common.ucCompressors  ==  CONST_audioCompressors_acm  )  {
				  #ifdef  __SUPPORT_acmToDec__
						  if  (  pTransform->audio.u.acm.hstr1  )  {			
							  acmStreamClose(  pTransform->audio.u.acm.hstr1,  0  );	pTransform->audio.u.acm.hstr1	=	NULL;
						  }
						  if  (  pTransform->audio.u.acm.hstr2  )  {
							  acmStreamClose(  pTransform->audio.u.acm.hstr2,  0  );	pTransform->audio.u.acm.hstr2	=	NULL;	
						  }	
				  #else
						  exitDecompress_filterGraph(  &pTransform->audio.u.dmo  );
				  #endif
				  }
		else  if  (  pTransform->audio.ta.compressor.common.ucCompressors  ==  CONST_audioCompressors_dmo  )  {
				  exitDecompressAudio_dmo(  &pTransform->audio.u.dmo  );
				  }
		else  {
			  CUS_MODULE_U	*	pModule  =  NULL;
			  /*
			  switch  (  pTransform->audio.ta.compressor.common.ucCompressors  )  {
					  case  CONST_audioCompressors_ipp:
						    pModule  =  pQyMc->cusModules.pIpp;
						    break;
					  case  CONST_audioCompressors_vorbis:	//  2016/12/05
						    pModule  =  pQyMc->cusModules.pQdc_vorbis_dec;
						    break;
					  case  CONST_audioCompressors_custom:
						    pModule  =  getCusModule(  &pQyMc->cusModules,  CONST_moduleType_compress  );
							break;
					  default:
						  traceLogA(  (char*)  "exitTaskAvFrom_audio: ucCompressors error, %d",  pTransform->audio.ta.compressor.common.ucCompressors  );
						  qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "exitTaskAvFrom_audio: ucCompressors error, %d"  ),  (  int  )pTransform->audio.ta.compressor.common.ucCompressors  );
							 break;
			  }
			  */
			  M_getCompressModule(  pCusModules,  pTransform->audio.uiModuleType_toDec,  pModule  );	//  2012/09/09


			  if  (  pModule  &&  pModule->compress.pf_qdcExitDecompressAudio  )  {
				  pModule->compress.pf_qdcExitDecompressAudio(  &pTransform->audio.u.qoi.myQoi.common  );	
			  }
		}
		
		//  2015/05/19
		MACRO_safeFree(  pTransform->audio.saveAudio.pSaveAudioPkt  );

		//  2010/05/04
		memset(  &pTransform->audio.u,  0,  sizeof(  pTransform->audio.u  )  );

		//
		if  (  pTransform->audio.pWf_compress  )  M_free(  pTransform->audio.pWf_compress  );
		if  (  pTransform->audio.pWf_pcm  )  M_free(  pTransform->audio.pWf_pcm  );
		if  (  pTransform->audio.pWf_decompress  )  M_free(  pTransform->audio.pWf_decompress  );
	
		if  (  pTransform->audio.pBuf_pcm  )  M_free(  pTransform->audio.pBuf_pcm  );

		//  if  (  pFrom->audio.pDecompressBuf_transferAudioData  )  M_free(  pFrom->audio.pDecompressBuf_transferAudioData  );

		//  2012/03/19
		memset(  &pTransform->audio.status,  0,  sizeof(  pTransform->audio.status  )  );
			
		//
		pTransform->audio.ucbInited  =  FALSE;
	}

//  errLabel:

	qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  "",  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "exitTaskAvFrom_audio %d"  ),  pTransform->index_activeMems_from  );

	//  traceLogA(  (char*)  "exitTaskAvFrom_audio: %I64u leaves",  pFrom->idInfo.ui64Id  );
	traceLogA(  (char*)  "exitTaskAvFrom_audio leaves"  );


	return;
}


 //
 #define		MIN_taskTimeoutInS										50	//  15								//  2008/06/21

//
 int  tmpHandler_restartRobotTask(  QY_MC  *  pQyMc,  void  *  p0,  void  *  p1,  TASK_common * taskElem  )
 {
	 int						iErr				=	-1;
	 COMMON_PARAM			*	pCommonParam0		=	(  COMMON_PARAM  *  )p0;
     //QY_MC					*	pQyMc				=	(  QY_MC  *  )pCommonParam0->p0;
	 QY_SERVICEGUI_INFO		*	pSci				=	(  QY_SERVICEGUI_INFO  *  )pCommonParam0->p1;
	 MIS_CNT				*	pMisCnt				=	(  MIS_CNT  *  )pCommonParam0->p2;
	 //
	 MC_VAR_isCli			*	pProcInfo			=	QY_GET_procInfo_isCli(  );
	 
	 QMC_TASK_INFO * pTaskInfo=(QMC_TASK_INFO*)getQmcTaskInfoByIndex(pProcInfo,taskElem->m_index_taskInfo);
	 if(!pTaskInfo ) return -1;
	 MIS_MSGU  *  pMsgElem=&pTaskInfo->var.pTaskData->msgU;

	 //
	 if  (  pTaskInfo->var.bNeedRemoved
		 ||  pTaskInfo->var.bTaskInvalid  )  
	 {
		 // skipped			 
		 return  0;
	 }

	 do {
		 //
		 if (pMsgElem->uiType == CONST_misMsgType_task) {
			 IM_CONTENTU* pContent = (IM_CONTENTU*)pMsgElem->task.data.buf;

			 //if  (  pContent->uiType  ==  CONST_imCommType_transferFileReplyReq  )  
			 if (pContent->uiType == CONST_imCommType_transferFileReq
				 && pTaskInfo->var.m_bReplyTask)
			 {
				 TASK_transferFile* task = (TASK_transferFile*)taskElem;
				 QMC_taskData_transferFile* pTt = (QMC_taskData_transferFile*)pTaskInfo->var.pTaskData;

				 //
				 if (1) {
					 DWORD  tickCnt = myGetTickCount(mynull);
					 int  iDiffInMs = tickCnt - pTaskInfo->var.dwTickCnt_recv_lastRefreshed;
					 if (abs(iDiffInMs) < 5000) {
						 iErr = 0;  break;
					 }
				 }

				 //
				 DWORD  dwTickCnt = GetTickCount();
				 int  iDiffInMs = dwTickCnt - pTt->dwLastReportTickCnt;
				 if (iDiffInMs > MIN_taskTimeoutInS * 1000) {

					 //
					 task->myTask.nTimes_toRestart++;

					 //
					 if (task->myTask.uiLastDataBlockIndex < 30) {
						 if (task->myTask.nTimes_toRestart > 3) {
							 task->myTask.uiSizePerSnd_internal = task->myTask.uiSizePerSnd_internal / 2;
							 //
#define  MIN_uiSizePerSnd_file_big			MIN_uiSizePerSnd_file
#define  MIN_uiSizePerSnd_file_mid			128  *  1024
#define  MIN_uiSizePerSnd_file_small		64  *  1024
//
							 int  minVal = MIN_uiSizePerSnd_file_big;
							 //				
							 if (task->myTask.nTimes_toRestart > 9) {
								 minVal = MIN_uiSizePerSnd_file_small;
							 }
							 else  if (task->myTask.nTimes_toRestart > 6) {
								 minVal = MIN_uiSizePerSnd_file_mid;
							 }
							 //
							 if (task->myTask.uiSizePerSnd_internal < minVal) {
								 task->myTask.uiSizePerSnd_internal = minVal;
							 }

							 //
							 TCHAR  tBuf[128];
							 _sntprintf(tBuf, mycountof(tBuf), _T("nTimes_toRestart %d, sizePerSnd adjusted to %d"), task->myTask.nTimes_toRestart, task->myTask.uiSizePerSnd_internal);
							 showInfo_open0(0, 0, tBuf);
						 }
					 }

					 //
					 chkToApplyForChannel(pProcInfo, CONST_channelType_robot,  true );

					 //
					 TRANSFER_FILEDATA_REQ	req;
					 int						lenInBytes;
					 unsigned  int			uiChannelType = CONST_channelType_talking;		//  »Ö¸´²Ù×÷ÓÃtalkingÍ¨µÀ¡£ÒòÎª¿ÉÄÜrobotÍ¨µÀËÀÁË

					 memset(&req, 0, sizeof(req));
					 req.uiType = CONST_imCommType_transferFileDataReq;

					 req.uiSizePerSnd = task->myTask.uiSizePerSnd_internal;
					 req.tStartTime_org = task->myTask.reply_info.replyReq.tStartTime_org;
					 req.uiTranNo_org = task->myTask.reply_info.replyReq.uiTranNo_org;
					 req.uiSerialNo_org = task->myTask.reply_info.replyReq.uiSerialNo_org;

					 //
					 if (!task->myTask.uiLastDataBlockIndex)  req.uiDataBlockIndex = 0;
					 else  req.uiDataBlockIndex = task->myTask.uiLastDataBlockIndex + 1;

					 //
#if  0
					 __int64 tStartTime = task->myTask.reply_info.tStartTime_reply;
					 uint uiTranNo = task->myTask.reply_info.uiTranNo_reply;
#endif
					 //
					 MACRO_prepareForTran();
					 //
					 QY_MESSENGER_ID  idInfo_dst = pMsgElem->task.data.route.idInfo_from;

					 //
					 qyShowInfo1(CONST_qyShowType_qwmComm, 0, (char*)(""), pProcInfo->who_showInfo, 0, _T(""), _T(""),
						 _T("restart robot task %d times, uiDataBlockIndex %d, sizePerSnd %d. to %I64u. tn %d, channel %s"),
						 task->myTask.nTimes_toRestart, req.uiDataBlockIndex, req.uiSizePerSnd, idInfo_dst.ui64Id, uiTranNo,
						 qyGetDesByType1(CONST_channelTypeTable, uiChannelType));

					 //
					 task->myTask.reply_info.tStartTime_lastFileDataReq = tStartTran;
					 task->myTask.reply_info.uiTranNo_lastFileDataReq = uiTranNo;



					 //
					 lenInBytes = sizeof(req);
					 //
#ifdef ORG_FILE_SEND_LOGIC



					 int uiBlocks = (task->myTask.ui64FileLen - task->myTask.uiLastDataBlockIndex * task->myTask.uiSizePerSnd_internal - 1) / task->myTask.uiSizePerSnd_internal + 1;
					 req.us_nBlocks = min(task->myTask.MAX_FILE_SEND_BLOCK_internal, uiBlocks);
					 task->myTask.reqBlock = req.us_nBlocks;



					 if (req.us_nBlocks > 0 && postMsg2Mgr_mc(pMisCnt, NULL, CONST_misMsgType_outputTask, 0, CONST_qyCmd_sendRobotTaskData, tStartTran, uiTranNo, 0, (char*)&req, lenInBytes, &pMsgElem->task.addr_logicalPeer.idInfo, &idInfo_dst, uiChannelType, NULL, FALSE))  goto  errLabel;
#else 
					 if (postMsg2Mgr_mc(pMisCnt, NULL, CONST_misMsgType_outputTask, 0, CONST_qyCmd_sendRobotTaskData, tStartTran, uiTranNo, 0, (char*)&req, lenInBytes, &pMsgElem->task.addr_logicalPeer.idInfo, &idInfo_dst, uiChannelType, NULL, FALSE))  goto  errLabel;
#endif


				 }
			 }
		 }

		 iErr = 0;
	 } while (false);

errLabel:
	 return  iErr;
 }


 //
 int  restartRobotTask(  QY_MC  *  pQyMc,  QY_SERVICEGUI_INFO  *  pSci,  MIS_CNT  *  pMisCnt,  CTX_MC_THREAD  *  pCtx  )
{
	COMMON_PARAM		commonParam;
	MIS_CHANNEL		*	pChannel		=	NULL;
	
	if  (  !pMisCnt  )  return  -1;

	pChannel  =  getChannelByType(  pMisCnt,  CONST_channelType_talking  );		//  ×¢Òâ£ºÕâÀïÊ¹ÓÃµÄÊÇtalkingÍ¨µÀ¡£ÒòÎª»Ö¸´ÈÎÎñµÄÖ¸ÁîÐèÒªÔÚtalking·¢ËÍ¡£
	Param_dbg  param;
	param.m_pHint=(TCHAR*)_T("restartRobotTask.3917");
	//
	if  (  !bChannelOk(  pChannel,&param  )  )  return  -1;

	MACRO_makeCommonParam3(  pQyMc,  pSci,  pMisCnt,  commonParam  );
	pCtx->pProcessQ->qTraverse(  tmpHandler_restartRobotTask,  &commonParam,  0  );

	 return  0;
}


 //
 extern "C" DWORD WINAPI mcThreadProc_mis_robot( LPVOID lpParameter )
{
	 int							iErr				=	-1;
	 QY_MC						*	pQyMc				=	QY_GET_GBUF(  );
	 QY_SERVICEGUI_INFO			*	pSci				=	(  QY_SERVICEGUI_INFO  *  )lpParameter;
	 MC_VAR_isCli					*	pProcInfo			=	(  MC_VAR_isCli  *  )pSci->pVar;
	 int							loopCtrl			=	0;
	 int							i;
	 DWORD							dwThreadId			=	GetCurrentThreadId(  );
	 CQyMalloc						mallocObj;
	 MIS_MSGU					*	pMsg				=	NULL;
	 unsigned  int					len;
	 DWORD							dwRet;
	 //  long							lPrev;
	 CTX_MC_THREAD					ctx;
	 BOOL							bMsgArrive			=	FALSE;
	 //
	 unsigned  int					uiChannelType		=	CONST_channelType_robot;
	 
	 //
#ifdef  __DEBUG__
		traceLogA(  (char*)  "mcThreadProc_mis_robot:  enters"  );
#endif

	 //
	 memset(  &ctx,  0,  sizeof(  ctx  )  );
	 ctx.pProcessQ  =  &pProcInfo->processQ_media;	//  robot;

	 if  (  !(  pMsg  =  (  MIS_MSGU  *  )mallocObj.mallocf(  CONST_iAllocType_longTimeMsg,  sizeof(  MIS_MSGU  )  )  )  )  goto  errLabel;

	 for  (  ;  !pQyMc->bQuit;  loopCtrl  ++  )  {
		 if (!pQyMc->bLogon) {
			 break;
		 }

		  dwRet  =  WaitForSingleObject(  pProcInfo->robotQ.hSemaTrigger,  3500  );
		  if  (  dwRet  ==  WAIT_FAILED  )  goto  errLabel;
		  
		  bMsgArrive  =  FALSE;

		  for  (  ;  !pQyMc->bQuit;  )  {
			   len  =  sizeof(  pMsg[0]  );
			   if  (  qGetMsg(  &pProcInfo->robotQ,  pMsg,  &len  )  )  break;
			   memset(  (  (  char  *  )pMsg  )  +  len,  0,  min(  256,  sizeof(  pMsg[0]  )  -  len  )  );
			   
			   bMsgArrive  =  TRUE;

			   switch  (  pMsg->uiType  )  {
					   case  CONST_misMsgType_input:  {					
						     MIS_CNT		*	pMisCnt		=  (  MIS_CNT  *  )pMsg->input.pMisCnt;
							 MIS_CHANNEL	*	pChannel	=	NULL;

							 if  (  !pMisCnt  )  {
								 traceLogA(  (char*)  "mcThreadProc_mis_robot failed: pMisCnt is null"  );
								 break;
							 }
							 traceLog((TCHAR*)  _T(  "mcThreadProc_mis_robot: %s {%s}"  ),  isUcFlgResp(  pMsg->input.ucFlg  )  ?  _T(  "resp"  )  :  _T(  "req"  ),  qyGetDesByType1(  CONST_qyCmdTable,  pMsg->input.usCode  )  );
						     
							 if  (  !(  pChannel  =  getChannelByType(  pMisCnt,  uiChannelType  )  )  )  break;

							 if  (  isUcFlgResp(  pMsg->input.ucFlg  )  )  {
								 if  (  procMsgInput_other_resp(  pQyMc,  pSci,  pProcInfo,  &pMsg->input,  len,  &ctx,  pChannel  )  )  break;							 
								}
							 else  {
								   if  (  procMsgInput_other_req(  pQyMc,  pSci,  pProcInfo,  &pMsg->input,  len,  &ctx,  pChannel  )  )  break;							 								
							 }							 
													  
							 }
							 break;
					   case  CONST_misMsgType_req:
						     break;
					   case  CONST_misMsgType_talk:
						     traceLogA(  (char*)  "mcThreadProc_mis_robot: msg_talk "  );
						     break;
					   case  CONST_misMsgType_task:  {
						     MIS_CNT		*	pMisCnt  =  (  MIS_CNT  *  )pMsg->task.pMisCnt;
							 MIS_CHANNEL	*	pChannel	=	NULL;

							 if  (  !pMisCnt  )  break;
							 if  (  !(  pChannel  =  getChannelByType(  pMisCnt,  uiChannelType  )  )  )  break;

							 if  (  procMsgTask_mc_robot(  pQyMc,  pSci,  pProcInfo,  &pMsg->task,  len,  FALSE,  &ctx,  pChannel  )  )  break;

							 printMisMsg(  0,  0,  pMsg  );

							 }
						     break;
					   case  CONST_misMsgType_applyForChkChannels_qmc:  {
						     MIS_CNT	*	pMisCnt		=	(  MIS_CNT  *  )pMsg->applyForChkChannels_qmc.pMisCnt;
							 if  (  !pMisCnt  )  break;

							 //  if  (  pMsg->applyForChkChannels_qmc.bTaskExists  )  
							 {
                                 startChannel(  pProcInfo,  pMisCnt,  getChannelByType(  pMisCnt,  CONST_channelType_robot  ),  0  );  		

#if  0
								 //  if  (  pMsg->applyForChkChannels_qmc.bTaskNeedRestart  )  
								 if  (  0  )
								 {
									 traceLog((TCHAR*)  _T(  "robot: to restart robot task"  )  );
									 qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "robot: to restart tasks"  )  );

									 restartRobotTask(  pQyMc,  pSci,  pMisCnt,  &ctx  );
								 }
#endif 

							 }						 

							 }						     
						     break;
#if  0
					   case  CONST_misMsgType_applyForChkTasks_qmc:		//  2009/09/10
						     //qisChkTasks(  pProcInfo,  CONST_channelType_robot  );
						     break;
#endif
					   case  CONST_misMsgType_outputTask:  
					   default:
						        traceLogA(  (char*)  "µÃµ½Î´´¦ÀíµÄÏûÏ¢: %S",  qyGetDesByType1(  CONST_misMsgTypeTable,  pMsg->uiType  )  );
								break;
			   }
			   
		
			   //  dwRet  =  WaitForSingleObject(  pProcInfo->robotQ.hSemaTrigger,  50  );
			   //  if  (  dwRet  ==  WAIT_FAILED  )  goto  errLabel;			   
		  }


	      if  (  !(  loopCtrl  %  5  )  )  {

			  //  ÏÂÃæ×¢Òâ°Ñ²»ÓÃµÄÍ¨µÀ¸ø»ØÊÕ»ØÀ´
			  //  for  (  i  =  0;  i  <  mycountof(  pProcInfo->misCnts  );  i  ++  )  
			  for  (  i  =  0;  i  <  pProcInfo->ucCnt_misCnts;  i  ++  )  
			  {
				   MIS_CNT		*	pMisCnt		=  getMisCntByIndex(  0,  pProcInfo,  i  );  //&pProcInfo->misCnts[i]; 
				   MIS_CHANNEL	*	pChannel	=	NULL;
				   //
				   if  (  !pMisCnt  )  continue;
				   //
				   if  (  !pMisCnt->cfg.dynCfg.cnt.usCntPort  )  continue;

				   if  (  !(  pChannel  =  getChannelByType(  pMisCnt,  uiChannelType  )  )  )  continue;
				   //
				   if  (  !pChannel->hThread_io  )  continue;

				   waitForObject(  &pChannel->hThread_io,  0  );
				   if  (  !pChannel->hThread_io  )  {
					   qyShowInfo1(  CONST_qyShowType_qwmComm,  0,  (char*)  (  ""  ),  pProcInfo->who_showInfo,  0,  _T(  ""  ),  _T(  ""  ),  _T(  "%s is closed"  ),  qyGetDesByType1(  CONST_channelTypeTable,  pChannel->uiType  )  );
				   }


			  }

			  //  ¼ÙÉèÖÐ¼ä¶ÏÏßÁË£¬»òÆäËûÔ­Òò£¬ÔòÒª»Ö¸´ÈÎÎñ
			  //  qTraverse(  &processQ,  (  PF_commonHandler  )tmpHandler_procRobotTask,  0,  0  );
		  }
	
		  //
		  if (!(loopCtrl % 2)) {
			  if (10)
			  {
				  MIS_CNT* pMisCnt = pProcInfo->getMisCntByName(_T(""));

				  if (0) {
					  traceLog((TCHAR*)_T("robot: to restart robot task"));
					  qyShowInfo1(CONST_qyShowType_qwmComm, 0, (char*)(""), pProcInfo->who_showInfo, 0, _T(""), _T(""), _T("robot: to restart tasks"));
				  }

				  //
				  restartRobotTask(pQyMc, pSci, pMisCnt, &ctx);
			  }
		  }


	 }

	 iErr  =  0;
	 
errLabel:

	 //  for  (  i  =  0;  i  <  mycountof(  pProcInfo->misCnts  );  i  ++  )  
	 for  (  i  =  0;  i  <  pProcInfo->ucCnt_misCnts;  i  ++  )  
	 {
		  MIS_CNT  *  pMisCnt  =  getMisCntByIndex(  0,  pProcInfo,  i  );  //  &pProcInfo->misCnts[i]; 
		  //
		  if  (  !pMisCnt  )  continue;
		  //
		  if  (  !pMisCnt->cfg.dynCfg.cnt.usCntPort  )  continue;

		  waitForChannel(  pProcInfo,  pMisCnt,  CONST_channelType_robot,  TRUE  );
	 }


	 if  (  pProcInfo  )  pProcInfo->status.threadsStatus.ulbRobotQuit  =  TRUE;

	 traceLogA(  (char*)  "mcThreadProc_mis_robot:  leaves"  );

	 return  iErr;
}


 






