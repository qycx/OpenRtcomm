 int  tmpHandler_procRobotTask(  void  *  p0,  void  *  p1,  MIS_MSGU  *  pMsg  )
{

	traceLogA(  (char*)  "´Ëº¯ÊýÓÃÓÚÖÜÆÚÐÔµÄ´¦ÀíÈÎÎñ£¬ÒÔ·ÀÖ¹ÖÐÍ¾ÖÐÖ¹µÄÈÎÎñ³ÉÎªÄÚ´æÀ¬»ø"  );

