				makeWaveFormat_pcm(  DEFAULT_nChannels_pcm_av_old,  DEFAULT_iHertz_pcm_av_old,  DEFAULT_wBitsPerSample_pcm_av_old,  &pTransform->audio.ta.ah_decompress.wfx  );
