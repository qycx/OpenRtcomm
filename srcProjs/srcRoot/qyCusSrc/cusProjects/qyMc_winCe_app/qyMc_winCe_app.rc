IDI_QYMC_WINCE_APP      ICON                    "qyMc_winCe_app.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_FILE_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      IDM_HELP_ABOUT
    END
END

IDR_MENU_const MENU 
BEGIN
    POPUP "const"
    BEGIN
        MENUITEM "ID_MENU_conferenceWall_minCmd", ID_MENU_conferenceWall_minCmd
        MENUITEM "ID_MENU_conferenceWall_maxCmd", ID_MENU_conferenceWall_maxCmd
        MENUITEM SEPARATOR
        MENUITEM "ID_MENU_isCmd_min",           ID_MENU_isCmd_min
        MENUITEM "ID_MENU_isCmd_max",           ID_MENU_isCmd_max
        MENUITEM SEPARATOR
        MENUITEM "ID_qyLeftKey",                ID_qyLeftKey
        MENUITEM "ID_qyRightKey",               ID_qyRightKey
    END
END


