/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_QYMCPOPUP MENU 
BEGIN
    POPUP "Popup - 0"
    BEGIN
        MENUITEM "qyProperties(&S)",            ID_qyProperties
    END
    POPUP "popup_viewPcList  - 1"
    BEGIN
        MENUITEM "qyEdit(&B)",                  ID_qyEdit
        MENUITEM SEPARATOR
        MENUITEM "qySendMsg(&F)",               ID_qySendMsg
        MENUITEM SEPARATOR
        MENUITEM "qyDel(&S)",                   ID_qyDel
        MENUITEM SEPARATOR
        MENUITEM "qyProperties(&H)",            ID_qyProperties
    END
    POPUP "popup_viewPcUsrList  - 2"
    BEGIN
        MENUITEM "qyEdit(&B)",                  ID_qyEdit
        MENUITEM SEPARATOR
        MENUITEM "??(&S)",                      ID_qyDelPcUsr
        MENUITEM SEPARATOR
        MENUITEM "??(&H)",                      ID_qyProperties
    END
    POPUP "popup_viewPcRuleList - 3"
    BEGIN
        MENUITEM "????????(&D)",                ID_qyCfgPcRule
        MENUITEM SEPARATOR
        MENUITEM "??(&S)",                      ID_qyDelPcRule
    END
    POPUP "popup_viewVlanMgrList - 4"
    BEGIN
        MENUITEM "???Lan???(&H)",               ID_qyRefreshVlanPolicy
        MENUITEM SEPARATOR
        MENUITEM "????????(&B)",                ID_qyCfgProxyRule
        MENUITEM SEPARATOR
        MENUITEM "??(&S)",                      ID_qyDelProxy
    END
    POPUP "popup_viewUnchkedPcList - 5"
    BEGIN
        MENUITEM "?????(&S)",                   ID_qyStopUnchk
    END
    POPUP "popup_viewWillAttackPcList - 6"
    BEGIN
        MENUITEM "????(&T)",                    ID_qyStopWillAttack
    END
    POPUP "popup_viewPcUsrInTab1List  - 7"
    BEGIN
        MENUITEM "qyEditPcUsrInTab1(&B)",       ID_qyEditPcUsrInTab1
        MENUITEM SEPARATOR
        MENUITEM "??(&S)",                      ID_qyDelPcUsrInTab1
    END
    POPUP "popup_viewPcList_netMc2  - 8"
    BEGIN
        POPUP "monitor(&J)"
        BEGIN
            MENUITEM "monitoring Desktop",          ID_monDesktop
            MENUITEM "Cancel Monitoring Desktop",   ID_cancelMonDesktop
            MENUITEM SEPARATOR
            MENUITEM "secChk Event",                ID_pcSecChkEventList
            MENUITEM SEPARATOR
            MENUITEM "ID_pcRegistryList",           ID_pcRegistryList
            MENUITEM "ID_pcRegistryRuleStatusList", ID_pcRegistryRuleStatusList
            MENUITEM SEPARATOR
            MENUITEM "ID_pcEventLogList(&T)",       ID_pcEventLogList
            MENUITEM "ID_pcOsUsrList(&Z)",          ID_pcOsUsrList
            MENUITEM "NetStat??(&L)",               ID_qyPcNetStatList
            MENUITEM "ID_pcPrinterPropList(&Y)",    ID_pcPrinterPropList
            MENUITEM "ID_qyPcSpList(&B)",           ID_qyPcSpList
        END
        MENUITEM "ID_qyCfgPcRule(&D)",          ID_qyCfgPcRule
        POPUP "yuanChengZhuoMianGuanLi(&P)"
        BEGIN
            MENUITEM "view Remote Desktop(&Y)",     ID_viewRemoteDesktop
            MENUITEM "cancel Remote Desktop(C)",    ID_cancelRemoteDesktop
            MENUITEM SEPARATOR
            MENUITEM "queryNetworkProp(&W)",        ID_queryNetworkProp
            MENUITEM "queryProxyCfg(&D)",           ID_queryProxyCfg
            MENUITEM "queryComputerInfo(&J)",       ID_queryComputerInfo
            MENUITEM "query windows update policy", ID_queryPcWindowsUpdatePolicyProp
            MENUITEM SEPARATOR
            MENUITEM "pcProcessPropList",           ID_pcProcessPropList
            MENUITEM SEPARATOR
            MENUITEM "pcNetFlowPropList(&L)",       ID_pcNetFlowPropList
            MENUITEM "ID_pcNetFlowPropList_ethernet(&E)", ID_pcNetFlowPropList_ethernet
        END
        MENUITEM SEPARATOR
        MENUITEM "ID_qyEdit(&B)",               ID_qyEdit
        MENUITEM "ID_qyCfgStandardName(&G)",    ID_qyCfgStandardName
        MENUITEM SEPARATOR
        MENUITEM "ID_qyDel(&S)",                ID_qyDel
